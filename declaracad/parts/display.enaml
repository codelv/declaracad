from declaracad.occ.api import (
    Part, DisplayLine, Vertex, Box, Topology, Looper, Transform, Shape, Loft
)


enamldef Axis(Part): part:
    """ Displays an XYZ lines """
    color = 'black'

    DisplayLine: xaxis:
        color := part.color
        position := part.position
        direction = (1, 0)
    DisplayLine: yaxis:
        color := part.color
        position := part.position
        direction = (0, 1)
    DisplayLine:
        color := part.color
        position := part.position
        direction = (0, 0, 1)


enamldef BoundingBox(Box):
    """ Displays a bounding box of the shape

    """
    attr shapes
    attr enlarge = 0
    attr bounding_box << Topology.bbox(shapes, tolerance=self.tolerance, enlarge=self.enlarge)
    attr units = 'mm'
    position << bounding_box.min
    transparency = 0.9
    description = f'Bounds:\n' \
                  f'dx={format_value(dx)}{units}\n' \
                  f'dy={format_value(dy)}{units}\n' \
                  f'dz={format_value(dz)}{units}'
    dx << bounding_box.dx
    dy << bounding_box.dy
    dz << bounding_box.dz

    func format_value(v):
        if units == 'in':
            v = v/25.4
        return round(v, 3)


enamldef TopologyPoints(Part): part:
    """ Highlights points on a TopoDS_Wire

    """
    attr topods_shape

    func get_points(s):
        return Topology(shape=s).points

    Looper:
        iterable << get_points(topods_shape)
        Vertex:
            color = part.color
            position = loop.item
            description = str(self.position[:])


enamldef LoftSections(Part): part:
    """ Displays a copy of all sections used to generate the given lofts

    """
    attr lofts

    func get_sections(shapes):
        if isinstance(shapes, Shape):
            shapes = [shapes]
        sections = []
        for shape in shapes:
            if not isinstance(shape, Loft):
                raise TypeError("Shapes must be a loft")
            sections.extend(shape.children)
        return sections

    Looper:
        iterable << get_sections(lofts)
        Transform:
            color << part.color
            shape << loop.item
