import os
from enaml.core.api import Include
from declaracad.occ.api import Part, load_model


enamldef LoadedPart(Part):
    """ Load a part from the given path. This will create subshapes
    for each piece in the part.

    """
    attr filename: str
    attr options: dict = {}
    description << filename[0:100]

    func load():
        shapes = load_model(filename, options)
        if color := self.color:
            for shape in shapes:
                shape.color = color
        if transparency := self.transparency:
            for shape in shapes:
                shape.transparency = transparency
        if material := self.material:
            for shape in shapes:
                shape.material = material
        return shapes

    Include:
        objects << load()
