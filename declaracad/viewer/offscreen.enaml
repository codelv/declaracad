from enaml.widgets.api import Window
from enaml.core.api import Include
from declaracad.occ.api import load_model
from declaracad.viewer.widgets.occ_viewer import OccViewer


enamldef OffscreenRenderer(Window):
    attr filename: str
    alias viewer
    OccViewer: viewer:
        Include:
            objects = load_model(filename)
