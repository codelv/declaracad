from math import sin, cos, radians, pi
from atom.api import Int, Float
from declaracad.parts.display import Axis
from declaracad.occ.api import (
    Looper, Transform, Part, Chamfer, ChamferData, Cylinder, Cut,
    Revol, Polyline, Wedge, Rotate, Face, Fuse
)
from enaml.core.declarative import d_, d_func


class Tool(Part):
    #: Tool number
    number = d_(Int(1))

    #: Feed per rev
    feed_per_rev = d_(Float(strict=False))

    @d_func
    def generate_gcode(self) -> list[str]:
        """ Tool change gcode """
        cmds = [
            f'T{self.number} M6'
        ]
        if self.description:
            cmds.insert(0, f'(Tool change: {self.description})')
        return cmds


enamldef TwistDrill(Tool): drill:
    #: Drill diameter
    #: This is used to check for errors
    attr diameter = 3

    #: Tool length from bottom of tool holder to tip of drill
    #: Used to check clearance for maximum cut depth
    attr length = 30

    #: For description
    attr angle = 60

    #: Used to calculate feed and speed
    attr flutes: int = 2

    #: Should be 1-3% of drill diameter
    #: Adjust this as needed based on the job and drill material
    feed_per_rev = self.diameter/25.4 * 0.02

    description = f"T{self.number} - {self.angle}° {self.flutes} flute " \
                  f"twist drill {round(self.diameter, 3)} dia by {self.length} len"
    material = 'steel'
    Chamfer:
        material = parent.material
        transparency = parent.transparency
        attr r = diameter/2*0.99
        attr d1 = r
        attr d2 = r*(pi/2-sin(radians(angle)))
        operations = [
            (d1, d2, self.children[0].topology.faces[2])
        ]
        Cylinder:
            radius = diameter/2
            height = length


enamldef EndMill(Tool): drill:
    #: Tool diameter
    #: This is used to determine the step over distance and pocket offsets
    attr diameter = 3

    #: Cutting edge length
    #: This is used to set the step down distance
    attr cut = 10

    #: Tool length from bottom of tool holder to tip of mill
    #: Used to check clearances for maximum cut depth
    attr length = 30

    #: Used to calculate feed and speed
    attr flutes: int = 4

    #: Feed per tooth
    #: Adjust this as needed based on the job and cutter material
    attr feed_per_tooth = 0.004

    #: Feed per rev is feed per tooth * number of flutes
    feed_per_rev = feed_per_tooth * flutes

    description = f"T{self.number} - {self.flutes} flute " \
                  f"end mill {round(self.diameter, 3)} dia x {self.cut} cut"

    material = 'steel'
    Cylinder:
        material = parent.material
        transparency = parent.transparency
        radius = diameter/2
        height = length


enamldef ChamferMill(Tool): drill:
    #: Tool diameter
    attr diameter = 3

    #: Tool length from bottom of tool holder to tip of mill
    #: Used to check clearances for maximum cut depth
    attr length = 30

    #: Tip angle (degrees)
    attr angle = 90

    #: Used to calculate feed and speed
    attr flutes: int = 4

    #: Feed per tooth
    #: Adjust this as needed based on the job and cutter material
    attr feed_per_tooth = 0.004

    #: Feed per rev is feed per tooth * number of flutes
    feed_per_rev = feed_per_tooth * flutes

    description = f"T{self.number} - {self.angle}° {self.flutes} flute " \
                  f"chamfer mill {round(self.diameter, 3)} dia by {self.length} len"
    material = 'steel'
    Chamfer:
        material = parent.material
        transparency = parent.transparency
        #disabled = True
        operations = [
            ChamferData(
                angle=radians(angle/2), 
                distance=diameter/2, 
                face=cyl.topology.faces[2],
                edge=cyl.topology.edges[2])
        ]
        Cylinder: cyl:
            radius = diameter/2
            height = length


enamldef FaceMill(Tool): cutter:
    #: Tool diameter
    attr diameter = 100

    #: Tool length from bottom of tool holder to tip of mill
    #: Used to check clearances for maximum cut depth
    attr length = 30

    #: Angle of carbide inserts
    attr angle = 90

    #: Number of inserts / cutting teeth
    attr inserts: int = 6

    #: Feed per tooth
    #: Adjust this as needed based on the job and cutter material
    attr feed_per_tooth = 0.004

    #: Feed per rev is feed per tooth * number of inserts
    feed_per_rev = feed_per_tooth * inserts

    description = f"T{self.number} - {self.angle}° {self.inserts} cutter " \
                  f"face mill {round(self.diameter, 3)} dia"
    material = 'steel'
    Fuse:
        material = parent.material
        transparency = parent.transparency
        Cylinder:
            radius = diameter/2
            height = length
        Cylinder:
            radius = 6
            position = (0, 0, length)
            height = length


enamldef ThreadMill(Tool): cutter:
    """ Single form thread milling cutter."""
    #: Tool diameter
    #: Diamter of cutting tooth 
    attr diameter = 3
    
    #: Diameter of shank
    attr shank_diameter = 4
    
    #: Diameter of neck
    attr neck_diameter = diameter*2/3

    #: Tool length from bottom of tool holder to tip of mill
    #: Used to check clearances for maximum cut depth
    attr length = 8
    
    #: Total tool length including shank
    attr total_length = 50
    
    #: Tooth pitch (P/mm)
    attr pitch = 0.8
    
    #: Tooth angle (degrees)
    attr angle = 60

    #: Radial thread depth
    attr thread_depth = pitch*cos(radians(90-cutter.angle))

    #: Used to calculate feed and speed
    attr flutes: int = 6
    
    #: Tool profile
    alias profile

    #: Feed per tooth
    #: Adjust this as needed based on the job and cutter material
    #: https://sct-usa.com/technical-data/thread-mill-feed-and-speed-chart/
    attr feed_per_tooth = 0.0003

    #: Feed per rev is feed per tooth * number of flutes
    feed_per_rev = feed_per_tooth * flutes

    description = f"T{self.number} - {self.flutes} flute " \
                  f"thread mill {round(self.diameter, 3)} dia x {self.pitch} pitch"
    material = 'steel'
    Cut:
        material = parent.material
        transparency = parent.transparency
        Revol:
            Face:
                Polyline: profile:
                    attr r1 = diameter/2
                    attr r2 = diameter/2 - thread_depth
                    attr r3 = neck_diameter/2
                    attr r4 = shank_diameter/2
                    closed = True
                    points = [
                        (0, 0, 0),
                        (r2, 0),
                        (r1, 0, pitch/2),
                        (r2, 0, pitch),
                        (r3, 0, 3/2*pitch),
                        (r3, 0, length),
                        (r3, 0, length),
                        (r4, 0, length+(r4-r3)),
                        (r4, 0, total_length),
                        (0, 0, total_length),
                    ]
        Looper:
            iterable = range(flutes)
            Transform:
                operations = [Rotate(angle=loop.index*2*pi/flutes)]
                Wedge:
                    direction = (0, -0.25, 1)
                    position = (0, -dx-profile.r2/2, -1)
                    dy = diameter
                    dx = diameter/2
                    itx = diameter/4
                    dz = diameter


enamldef Assembly(Part):
    Axis:
        pass
    ThreadMill:
        flutes = 6
        angle = 60
    
    TwistDrill:
        position = (-20, 0)
        angle = 60

    ChamferMill:
        position = (10, 0)

    EndMill:
        position = (20, 0)

    FaceMill:
        position = (200, 0)
