from declaracad.occ.api import Arc, Part, Looper, Wire


enamldef ArcSpiral(Part): part:
    """ Create an archimedean spiral in the xy plane

    """

    #: Starting radius
    attr start_radius

    #: Stopping radius
    attr end_radius

    #: Step over amount
    attr max_step_over

    #: Start angle relative to the positive x axis
    attr start_angle = 0

    #: Description
    description = f'Arc spiral start {start_radius}, end {end_radius}, step over {step_over}'

    # ------------------------------------------------------------------------
    # Internal variables
    # ------------------------------------------------------------------------

    #: Calculated step over amount. Will always be less than or equal to
    #: max_step_over.
    attr step_over = calculate_step_over(start_radius, end_radius, max_step_over)

    #: Change in radius
    attr dr = end_radius - start_radius
    attr path = generate_path()

    # ------------------------------------------------------------------------
    # G Code Options
    # ------------------------------------------------------------------------

    attr spindle_speed = 0
    attr spindle_pause = 1

    #: Feedrate used for gcode
    attr feedrate = 0

    #: Clockwise spiral
    attr clockwise: bool = True
    attr incremental: bool = True

    attr gcode: str = generate_gcode()

    description = "".join((
        f"\n  Start radius: {round(start_radius, 3)}\n"
        f"  End radius: {round(end_radius, 3)}\n",
        f"  Step over: {round(step_over, 3)}\n",
        f"  Spindle Speed: {spindle_speed}\n" if spindle_speed else "",
        f"  Feed: {feedrate}\n" if feedrate else "",
    ))

    func generate_gcode():
        cmds = []
        code = 'G2' if self.clockwise else 'G3'
        pos = self.position
        if self.spindle_speed:
            cmds.append(f"S{self.spindle_speed}")
        if self.spindle_pause:
            cmds.append(f"P{self.spindle_pause}")
        if self.feedrate:
            cmds.append(f"F{self.feedrate}")

        for arc in spiral.children:
            if not isinstance(arc, Arc):
                continue
            center = arc.position + pos
            start = arc.points[0] + pos[0:2]
            end = arc.points[-1] + pos[0:2] # Ingore Z
            delta = center - start if incremental else center
            i = format_value(delta.x)
            j = format_value(delta.y)
            x = format_value(end.x)
            y = format_value(end.y)
            cmd = f'{code} X{x} Y{y} I{i} J{j}'
            cmds.append(cmd)
        return cmds

    func calculate_step_over(r1, r2, max_step):
        """ Adjust step over so it lands exactly on the end radius

        """
        rmin = min(r1, r2)
        rmax = max(r1, r2)
        delta = rmax-rmin
        r = delta/max_step
        if r <= 1:
            # Do one revoluation
            return delta
        n = int(r)
        if n == r:
            # Stepover is multiple of max step
            return max_step
        # Solve n + 1 = delta/new_step
        if n & 1:
            new_step_over = delta/(n+1)
        else:
            new_step_over = delta/(n+2) # Force even number of steps
        assert new_step_over < max_step
        return new_step_over

    func generate_arc(i, a, r):
        p0 = Point(cos(a)*r, sin(a)*r)
        a += pi
        p1 = Point(cos(a)*r, sin(a)*r)
        if i & 1:
            pos = (cos(a)*step_over, sin(a)*step_over)
        else:
            pos = (0, 0)
        return a, pos, [p0, p1]

    func generate_path():
        steps = int(dr/step_over)
        arcs = []
        r = start_radius
        a = start_angle
        for i in range(steps):
            a, pos, pts = generate_arc(i, a, r)
            arcs.append((r, pos, pts))
            r += step_over

        # Add full circle to ensure final dimension
        a, pos, pts = generate_arc(0, a, end_radius)
        arcs.append((end_radius, pos, pts))
        a, pos, pts = generate_arc(0, a, end_radius)
        arcs.append((end_radius, pos, pts))
        return arcs

    Wire: spiral:
        color = parent.color
        name = 'ArcSpiral'
        Looper:
            iterable = path
            Arc:
                radius = loop.item[0]
                clockwise = part.clockwise
                position = loop.item[1]
                points = loop.item[2]
