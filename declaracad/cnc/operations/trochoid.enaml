from math import pi
from declaracad.occ.api import Part, Point, Arc, Segment, Conditional


enamldef Trochoid(Part): part:
    """ Create a trochoid from arcs with enter and exits.

    """
    #: Width of the trochoid
    attr width

    #: Direction the trochoid is pointing
    attr tangent

    #: Radius of the wave. If this is less than 1/2 the width
    #: a segment will be inserted to connect the two wave sections.
    attr wave_radius = width/2

    #: Radius of the return arcs
    attr return_radius = wave_radius/2

    #: Center position of the arcs
    attr center_point: Point = Point(0, 0, 0)

    #: Point of the center of the wave head
    attr head_point << wave_in.points[-1].midpoint(wave_out.points[0])

    #: Start and end points
    attr start_point << arc_in.topology.start_point
    attr end_point << arc_out.topology.end_point

    #: Enter and exit tangents
    attr default_enter_tangent = tangent.cross(self.direction if climb else -self.direction)
    attr default_exit_tangent = tangent.cross(-self.direction if climb else self.direction)
    attr enter_tangent = default_enter_tangent
    attr exit_tangent = default_exit_tangent

    # Aliases
    alias arc_in
    alias wave_in
    alias wave_out
    alias arc_out

    #: Clockwise or not
    attr climb: bool = True

    #: Internal
    attr d = direction.cross(part.tangent)

    Arc: arc_in:
        color = 'orangered'
        as_wire = True
        clockwise = not climb
        radius = return_radius
        attr p = wave_in.points[0]
        position = p.offset(radius, wave_in.position - p)
        points = [
            position.offset(radius, enter_tangent.rotated(-pi/2 if climb else pi/2)),
            p
        ]
    Arc: wave_in:
        radius = wave_radius
        color = 'blue'
        clockwise = not climb
        as_wire = True
        position = center_point.offset(radius-width/2 if climb else width/2-radius, d)
        points = [
            center_point.offset(-width/2 if climb else width/2, d),
            position.offset(radius, part.tangent),
        ]
    Conditional:
        condition << wave_in.points[-1] != wave_out.points[0]
        Segment:
            color = 'blue'
            as_wire = True
            points = [
                wave_in.points[-1],
                wave_out.points[0]
            ]
    Arc: wave_out:
        color = 'blue'
        as_wire = True
        radius = wave_in.radius
        clockwise = not climb
        position = center_point.offset(
            width/2-radius if climb else radius-width/2, d)
        points = [
            position.offset(radius, part.tangent),
            center_point.offset(width/2 if climb else -width/2, d),
        ]
    Arc: arc_out:
        color = 'orange'
        as_wire = True
        clockwise = not climb
        radius = return_radius
        attr p = wave_out.points[-1]
        position = p.offset(radius, wave_out.position - p)
        points = [
            p,
            position.offset(radius, exit_tangent.rotated(pi/2 if climb else -pi/2))
        ]
