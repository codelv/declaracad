from math import pi, radians, ceil
from atom.api import Atom, Instance, Float, Bool
from enaml.core.api import Looper
from declaracad.occ.api import (
    Arc, DisplayArrow, Part, Point, Polyline, Topology, Vertex
)
from declaracad.cnc.operation import Tool, Operation
from .helix import ArcHelix


class ThreadingData(Atom):
    bottom_point = Instance(Point)
    radius = Float()
    angle = Float()
    depth = Float()
    reverse = Bool()
    outside = Bool()


enamldef ThreadingOperation(Operation): operation:
    """ Generates a thread milling operation for the given set of holes.

    The helix is determined using the bottom of the hole and a provided depth.

    """
    #: G-Code Heading
    operation_type = f"Thread milling {' ' + name if name else ''}"

    #: List of cylinder faces
    attr holes: list = []

    #: Start at bottom and go up
    attr bottom_up: bool = True

    #: If true, left hand threads, else right hand threads
    attr left_hand: bool = False

    #: Clearance added to the offset.
    #: A positive number will leave extra stock between any walls
    #: A negative number will make take more stock away from the walls
    attr radial_clearance = 0

    #: Clearance added to the bottom of the hole
    #: A positive number will leave stock at the bottom
    #: A negative number will remove extra stock from the bottom
    attr bottom_clearance = tool.pitch/2

    # --------------------------------------------------------------------------
    # Speed and feed
    # --------------------------------------------------------------------------
    #: Slowdown factor
    attr slowdown_factor = 0.6

    #: Spindle speed calculation
    #: Assumes surface speed is in feet per minute
    #: Note: Max spindle speed is assumed to be available in the parent scope
    spindle_speed = min(max_spindle_speed, round(
        12 * surface_speed / (pi*tool.diameter/25.4) * slowdown_factor))

    #: Feedrate calculation
    feedrate = round(spindle_speed * tool.feed_per_rev, 2)

    # ------------------------------------------------------------------------
    # Internal variables
    # ------------------------------------------------------------------------
    attr last_point = start_point
    attr data = optimize_order(generate_data())

    func get_center(hole):
        """ Find center position of a hole
        """
        if isinstance(hole, Point):
            return hole
        elif Topology.is_cylinder(hole):
            s = Topology.cast_surface(hole)
            d = 2 * s.Radius()
        elif Topology.is_circle(hole):
            s = Topology.cast_curve(hole)
            d = 2 * s.Radius()
        else:
            raise ValueError(f"Cannot get center of {hole}")
        # Check tool diameter
        if tool.diameter > d:
            raise ValueError(
                f"Tool {tool.description} is too large for "
                f"hole of diameter {round(d, 3)}. Change the tool diameter "
                f"or just use the hole position to ignore this error.")
        return Point(s.Location())

    func generate_data():
        tool_radius = tool.diameter/2

        threading_data = []
        try:
            for hole in self.holes:
                if isinstance(hole, ThreadingData):
                    threading_data.append(hole)
                    continue
                elif isinstance(hole, (list, tuple)):
                    depth, diameter, hole = hole
                    center = get_center(hole)
                elif Topology.is_cylinder(hole):
                    s = Topology.cast_surface(hole)
                    center = Point(s.Location())
                    umin, umax, vmin, vmax = Topology(shape=hole).surface_bounds
                    depth = vmax - vmin
                    diameter = 2 * s.Radius()
                else:
                    raise ValueError("Thread must be a cylinder, threading data instance or tuple of (depth, diameter, center)")

                if depth > tool.length:
                    raise ValueError(f"Tool {tool} is not long enough to cut a {round(depth)} thread.")

                data = ThreadingData(
                    bottom_point=center + (0, 0,  bottom_clearance),
                    depth=depth,
                    radius=diameter/2 - 3/2*tool.thread_depth - radial_clearance
                )
                threading_data.append(data)
        except Exception as e:
            traceback.print_exc()
        return threading_data

    func optimize_order(data: list[ThreadingData]) -> list[ThreadingData]:
        """ Optimize the cutting order if multiple pockets are given."""
        if len(data) <= 1:
            return data
        drop_points = [Point(d.bottom_point.x, d.bottom_point.y, start_point.z) for d in data]
        reordered_data = []
        for pt in optimize_points(drop_points, start_point):
            i = drop_points.index(pt)
            reordered_data.append(data[i])
        return reordered_data

    func calculate_height(depth: float) -> float:
        # Adjust the start height so the helix
        # does a full arc and always an extra loop
        n = ceil(depth/tool.pitch) + 1
        return n * tool.pitch

    Looper:
        iterable = data

        Part:
            name = 'Threading Operation'
            attr center = loop.item.bottom_point
            attr top_point = helix.position
            attr bottom_point = center
            attr drop_point = Point(center.x, center.y, last_point.z)
            attr lift_point = Point(center.x, center.y, drop_point.z)
            attr depth = top_point.z - bottom_point.z
            attr lh = -1 if left_hand else 1
            attr bu = 1 if bottom_up else -1
            attr initial_point = bottom_point if bottom_up else top_point
            attr final_point = top_point if bottom_up else bottom_point
            attr arc_start = initial_point + (0, 0, helix.radius/3)

            DisplayArrow: drop_arrow:
                color = 'red'
                cone_size = (0.6, 1.5)
                tube_size = (0.3, 3)
                description = 'Drop'
                direction = (0, 0, -1)
                position = drop_point + (0, 0, 3)

            # Heliz down to bottom of hole or max step
            Vertex:
                color = 'lime'
                description = 'Top of circular pocket'
                position = top_point
            Vertex:
                description = 'Bottom of circular pocket'
                color = 'blue'
                position = bottom_point
            Polyline: move_to_point:
                line_style = 'dashed'
                color = 'lime'
                points = [last_point, drop_point, arc_start]

            Arc: arc_in:
                as_wire = True
                color = 'purple'
                name = 'Arc in'
                direction = (1, 0, 0)
                clockwise = True#left_hand
                radius = helix.radius/3
                position = arc_merge.topology.start_point + (0, 0, radius)
                alpha1 = 3*pi/2 if bottom_up else 0
                alpha2 = 0 if bottom_up else pi/2

            Arc: arc_merge:
                color = 'orange'
                name = 'Arc merge'
                as_wire = True
                position = arc_union.topology.start_point + (0, radius*bu)
                clockwise = left_hand
                radius = helix.radius/3
                alpha1 = pi if bottom_up else 0
                alpha2 = 3*pi/2 if bottom_up else pi/2

            Arc: arc_union:
                color = 'teal'
                name = 'Arc union'
                as_wire = True
                clockwise = left_hand
                position = initial_point + (arc_merge.radius*bu*lh, 0)
                radius = arc_merge.radius*2
                alpha1 = 3*pi/2 if bottom_up else pi/2
                alpha2 = 0 if bottom_up else pi

            ArcHelix: helix:
                color = 'maroon' if left_hand else 'darkslateblue'
                position = loop.item.bottom_point + (0, 0, height)
                radius = loop.item.radius
                height = calculate_height(loop.item.depth)
                pitch = tool.pitch
                bottom_up = operation.bottom_up
                clockwise = left_hand

            Arc: arc_out:
                color = 'blue'
                name = 'Arc out'
                as_wire = True
                radius = helix.radius/3
                clockwise = left_hand
                # Spiral end point
                position = final_point + (arc_merge.radius*bu*lh, 0)
                radius = arc_merge_out.radius*2
                alpha1 = 0 if bottom_up else pi
                alpha2 = pi/2 if bottom_up else 3*pi/2

            Arc: arc_merge_out:
                color = 'yellow'
                name = 'Arc merge out'
                as_wire = True
                radius = arc_up.radius
                clockwise = left_hand
                # Spiral end point
                position = arc_out.topology.end_point + (0, -radius*bu)
                radius = arc_up.radius
                alpha1 = pi/2 if bottom_up else 3*pi/2
                alpha2 = pi if bottom_up else 0

            Arc: arc_up:
                color = 'cyan'
                name = 'Arc up'
                as_wire = True
                direction = (1, 0, 0)
                radius = helix.radius/3
                clockwise = bottom_up
                position = arc_merge_out.topology.end_point + (0, 0, radius)
                alpha1 = 0 if bottom_up else pi
                alpha2 = pi/2 if bottom_up else 3*pi/2

            Polyline:
                name = 'Return path'
                line_style = 'dashed'
                color = 'lime'
                func get_points():
                    p = arc_up.topology.end_point
                    pts = [p, lift_point]
                    operation.last_point = lift_point
                    if loop.index + 1 == len(operation.data):
                        pts.append(end_point)
                    return pts

                points = get_points()

            DisplayArrow: lift_arrow:
                color = 'green'
                cone_size = drop_arrow.cone_size
                tube_size = drop_arrow.tube_size
                description = 'Lift'
                direction = (0, 0, 1)
                position = lift_point - (0, 0, 3)
