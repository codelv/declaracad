import os
from datetime import datetime
from declaracad.cnc.operation import Operation
from declaracad.occ.api import Include, Part, Point, Timer, Topology


enamldef Job(Part):
    """ A CNC job. Nest different operations within this and call save
    to write the gcode to a file.

    """
    #: Set to true to disable the whole job
    attr disabled: bool = False

    #: Precision to use when formatting values
    attr precision: int = 6

    #: Output distance values in inches
    attr inches: bool = True

    #: Filename to write to
    attr filename: str = generate_filename()

    #: Mapping of tool to tool number
    attr tools: dict = {}

    #: Tools that are not disabled
    attr active_tools: dict = {}

    #: Generate gcode file when all shapes are constructed
    constructed :: self.generate_job()

    #: Default starting point
    attr start_point = Point(0, 0, 50)

    #: Maximum spindle speed. If the calculated spindle rpm is over this
    #: back clamp the speed and back down the feed rate
    attr max_spindle_speed = 50000

    activated ::
        if self.disabled:
            # Propagate disabled to all operations
            for c in self.children:
                if isinstance(c, Operation):
                    c.disabled = True

    func format_value(v):
        """ Write formated value """
        if self.inches:
            v = v / 25.4
        return round(v, self.precision)

    func generate_filename():
        if '.' not in self.name:
            return f"{self.name}.nc"
        return self.name

    func generate_job():
        """ Generate gcode """
        try:
            if self.disabled:
                return
            tools = {}
            active_tools = {}

            enabled_operations = [
                c for c in self.children
                if isinstance(c, Operation) and not c.disabled
            ]
            n = len(enabled_operations)
            if n == 1 and enabled_operations[0].name:
                base, ext = os.path.splitext(self.filename)
                op = enabled_operations[0].name
                filename = f'{base}-{op}{ext}'
            else:
                filename = self.filename
            print(f"Generating job with {n} operation(s)...")
            print(f"Writing {os.path.abspath(filename)}")

            with open(filename, 'w') as f:
                f.write("(Generated with DeclaraCAD)\n")
                f.write(f"(File: {filename})\n")
                f.write(f"(Date: {datetime.now().strftime('%c')})\n")
                # Absolute mode, incremental arc mode, feed per minute, activate xy plane
                f.write("G90 G91.1 G94 G17\n")
                if self.inches:
                    f.write("G20\n")
                else:
                    f.write("G21\n")


                for c in self.children:
                    if isinstance(c, Operation):
                        # Validate tool
                        tool = c.tool
                        num = tool.number

                        if num in tools and tools[num] != tool:
                            raise ValueError(
                                f"Tool number {num} is duplicated! "
                                "Set another number or use a reference if "
                                "multiple operations use the same tool."
                            )
                        tools[num] = tool

                        if not c.disabled:
                            active_tools[num] = tool

                        # Write gcode
                        f.write(c.gcode)

            self.tools = tools
            self.active_tools = active_tools
            print(f"Wrote job to {filename}")
        except Exception as e:
            print(f"Error generating job: {e}")


enamldef JobSimulation(Part): simulation:
    attr job: Job
    attr rate = 0.2
    attr paused: bool = False
    attr autostart: bool = True
    attr disabled: bool = False
    attr index: int = 0
    attr frames: list = []

    #: Operation
    attr current_operation: Operation

    #: When the operation changes check if the part was re-oriented
    #: update which one is displayed
    current_operation ::
        op = change['value']
        new_part = op.part
        new_tool = op.tool
        new_part.display = True
        old_tool = None
        old_part = None
        if change['type'] == 'update':
            old_op = change['oldvalue']
            if old_op is not None:
                old_part = old_op.part
                old_tool = old_op.tool
        if old_part and old_part != new_part:
            old_part.display = False
            print(f"Part changed or reoriented:  {old_part}")
        if old_tool != new_tool:
            print(f"Tool change:  {new_tool.description}")

    rendered ::
        try:
            # Attempt to assign the simulation
            viewer.animation = self
        except NameError:
            pass
        if self.autostart:
            self.start()

    func start():
        if self.disabled:
            return
        self.render() # Force start
        frames = []
        for c in self.job.children:
            if isinstance(c, Operation) and not c.disabled:
                op = c
                op.part.display = False # Hide all
                for w in op.topology.wires:
                    path = Topology.discretize(w, rate, method='abscissa')
                    for p in path:
                        frames.append((op, p))
        if frames:
            op, pos = frames[0]
            op.part.display = True
        self.frames = frames
        timer.start()

    func goto(frame: int, relative: bool = False):
        if relative:
            i = self.index + frame
        else:
            i = frame
        self.index = max(0, min(len(frames), i))
        if self.paused:
            self.animate()

    func pause():
        self.paused = True
        timer.stop()

    func resume():
        self.paused = False
        timer.start()

    func animate():
        try:
            i = self.index
            self.index += 1
            op, pos = self.frames[i]
            self.current_operation = op
            op.tool.position = pos
        except IndexError:
            print("Simulation complete")
            timer.stop()
            self.index = 0
            self.paused = True
        except Exception as e:
            print(f"Simulation error: {e}")
            timer.stop()
            self.index = 0
            self.paused = True

    Include:
        #destroy_old = False
        objects << list(job.active_tools.values())

    Timer: timer:
        interval = 16
        timeout :: simulation.animate()
