import math
import traceback
from math import sin, cos, pi
from enaml.core.api import Conditional, Looper
from declaracad.cnc.interpolate import group_connected_faces
from declaracad.cnc.optimize import optimize_points
from declaracad.cnc.operation import (
    Operation, generate_polyline_gcode, generate_arc_gcode, generate_wire_gcode
)

from declaracad.occ.api import (
    Arc, Offset, Part, Point, Polyline, Topology, Wire
)


enamldef ArcEaseIn(Part):
    attr enter_point
    attr path_start
    attr start_angle
    attr arc_radius
    attr climb: bool
    Arc: arc_down:
        # Work backwards from the start point
        attr acos = cos(start_angle-pi/2)
        attr asin = sin(start_angle-pi/2)
        direction = (acos, asin, 0)
        clockwise = True
        name = 'Arc down'
        color = 'orange'
        attr arc_start = arc_center.points[0]
        radius = arc_center.radius
        position = (arc_start.x, arc_start.y, enter_point.z)
        points = [
            enter_point,
            arc_start
        ]
    Arc: arc_center:
        color = 'lime'
        name = 'Arc approach'
        clockwise = not climb
        attr a = start_angle + (-3*pi/2 if climb else 3*pi/2)
        attr acos = cos(a)
        attr asin = sin(a)
        attr arc_enter_start = arc_enter.points[0]
        radius = arc_enter.radius/2
        position = arc_enter_start + (radius*acos, radius*asin)
        points = [
            arc_enter_start + (2*radius*acos, 2*radius*asin),
            arc_enter_start
        ]
    Arc: arc_enter:
        color = 'teal'
        clockwise = not climb
        name = 'Arc enter'

        attr a1 = start_angle + (-pi/2 if climb else pi/2)
        attr a2 = start_angle + (pi if climb else -pi)

        # Position is at reverse angle
        attr acosr = cos(a2)
        attr asinr = sin(a2)
        attr acos = cos(a1)
        attr asin = sin(a1)
        radius = min(arc_radius/2, tool.diameter/2)
        position = path_start + (radius*acosr, radius*asinr)
        points = [
            position + (radius*acos, radius*asin),
            path_start
        ]

enamldef ArcEaseOut(Part):
    attr start_angle
    attr path_end
    attr exit_point
    attr arc_radius
    attr climb: bool
    Arc: arc_exit:
        clockwise = not climb
        radius = min(arc_radius/2, tool.diameter/2)
        name = 'Arc exit'
        # Position is at reverse angle
        attr acosr = cos(start_angle-pi)
        attr asinr = sin(start_angle-pi)
        attr a = start_angle-3*pi/2 if climb else start_angle-pi/2
        attr acos = cos(a)
        attr asin = sin(a)
        position = path_end + (radius*acosr, radius*asinr)
        points = [
            path_end,
            position + (radius*acos, radius*asin),
        ]

    Arc: arc_center:
        name = 'Arc approach'
        clockwise = not climb
        attr arc_exit_start = arc_exit.points[-1]
        attr a = start_angle-pi/2 if climb else start_angle-3*pi/2
        attr acos = cos(a)
        attr asin = sin(a)
        radius = arc_exit.radius/2
        position = arc_exit_start + (radius*acos, radius*asin)
        points = [
            arc_exit_start,
            arc_exit_start + (2*radius*acos, 2*radius*asin),
        ]

    Arc: arc_up:
        name = 'Arc up'
        attr acos = cos(start_angle-pi/2)
        attr asin = sin(start_angle-pi/2)
        direction = (acos, asin, 0)# if arc_start in
        attr arc_start = arc_center.points[-1]
        radius = arc_center.radius
        position = (arc_start.x, arc_start.y, exit_point.z)
        points = [
            arc_start,
            exit_point
        ]


enamldef ChamferOperation(Operation): operation:
    #: List of edges to cut. Each item can be a Chamfer refernce,
    #: a chamfered surface, or a set of edges or wires
    attr edges: list

    #: Distance to offset the bit
    attr bit_offset = 1

    attr clearance_height = start_point.z

    #: Use climb milling
    attr climb: bool = True

    # --------------------------------------------------------------------------
    # Speed and feed
    # --------------------------------------------------------------------------
    #: Slowdown factor
    attr slowdown_factor = 0.6

    #: Spindle speed calculation
    #: Assumes surface speed is in feet per minute
    spindle_speed = round(
        12 * surface_speed / (pi*tool.diameter/25.4) * slowdown_factor)

    #: Feedrate calculation
    feedrate = round(spindle_speed * tool.feed_per_rev, 2)

    # --------------------------------------------------------------------------
    # Internal data
    # --------------------------------------------------------------------------
    #: Generated toolpath data
    attr toolpath = generate_toolpath()

    func find_curve_on_point(topo, point):
        for v in topo.vertices:
            if Point(v) != point:
                continue
            for edge in topo.edges_from_vertex(v):
                if not Topology.is_circle(edge):
                    continue
                return edge

    func generate_for_hole(face):
        assert Topology.is_cone(face)
        topo = Topology(shape=face)
        surface = Topology.cast_surface(face, convert=False)
        cone = surface.Cone()
        center = Point(cone.Location())
        angle = round(math.degrees(cone.SemiAngle()), 6)
        if abs(angle*2) != tool.angle:
            raise ValueError(
                f"Tool {tool.description} cannot cut a chamfer of angle "
                f"{angle} (this operation does not support it)."
            )
        radius = cone.RefRadius()
        vertices = [Point(v) for v in topo.vertices]
        umin, umax, vmin, vmax = topo.face_bounds
        alpha = umax - umin
        top = bottom = vertices[0]
        for v in vertices[1:]:
            if v.z < bottom.z:
                bottom = v
            if v.z > top.z:
                top = v
        depth = top.z - bottom.z
        bottom_edge = find_curve_on_point(topo, bottom)

        start, end = [Point(v) for v in topo.vertices_from_edge(bottom_edge)]
        wire = Arc(
            position = center,
            radius = radius,
            as_wire = True,
            direction=(0, 0, -1),
            points = [start, end]).render()
        lift = drop = Point(center.x, center.y, clearance_height)
        return generate_offset(wire, 'hole', -1, center=center, lift=lift, drop=drop, radius=radius)

    func generate_for_faces(face, connected_faces):
        all_faces = connected_faces.union(set([face]))
        edges = Topology.find_unique_edges(all_faces)
        wires = Topology.join_edges(edges)
        wires.sort(key=lambda w: Topology.bbox(w).zmin)
        lowest_wire = wires[0]
        return generate_offset(lowest_wire, 'path')

    func generate_offset(wire, path_type, direction=1, drop=None, lift=None,
                         radius=None, center=None, **kwargs):

        if bit_offset:
            zmin = Topology.bbox(wire).zmin
            a = math.radians(tool.angle/2)
            offset = bit_offset*sin(a) * direction
            normal_distance = bit_offset*cos(a) * -direction
            try:
                offset_wire = Offset(
                    shape=wire,
                    offset=offset,
                    normal_distance=normal_distance
                ).render()
                offset_zmin = Topology.bbox(offset_wire).zmin
            except RuntimeException as e:
                offset_zmin = zmin + 1 # force reverse

            # If direction is wrong reverse
            # TODO: How do I determine this before??
            if offset_zmin > zmin:
                offset = -offset
                normal_distance = -normal_distance
                wire = Offset(
                    shape=wire,
                    offset=offset,
                    normal_distance=normal_distance
                ).render()
            else:
                wire = offset_wire

            if radius is not None:
                radius -= offset/2

        if climb:
            # Reverse direction
            wire = Wire(edges=[wire], reverse=True).render()

        curve_topo = Topology(shape=wire)
        start = curve_topo.start_point
        end = curve_topo.end_point

        if path_type == 'hole':
            r = min(radius/2, tool.diameter/2)/2
            v1 = start-center
            v2 = Point(r, 0)
            a = v2.angle2d(v1)
            if v1.y < 0:
                a = -a
            #print(f"angle = {math.degrees(a)}")
            kwargs['start_angle'] = a
            x, y = start.x-r*cos(a), start.y-r*sin(a)
            drop = lift = Point(x, y, clearance_height)
            enter = exit = Point(x, y, start.z+r)
        else:
            exit = end
            enter = start
            drop = Point(start.x, start.y, clearance_height)
            lift = Point(end.x, end.y, clearance_height)

        return {
            'type': path_type,
            'start': start,
            'end': end,
            'enter': enter,
            'exit': exit,
            'path': wire,
            'lift': lift,
            'drop': drop,
            'radius': radius,
            **kwargs
        }

    func generate_toolpath():
        tool_radius = tool.diameter/2
        data = []
        faces = []
        for shape in self.edges:
            if isinstance(shape, (tuple, list)):
                pass
            elif Topology.is_face(shape):
                faces.append(Topology.cast_shape(shape))

        connections = group_connected_faces(faces)
        for face, connected_faces in connections.items():
            if connected_faces:
                data.append(generate_for_faces(face, connected_faces))
            elif Topology.is_cone(face):
                data.append(generate_for_hole(face))
            else:
                raise NotImplementedError("TODO")

        ordered_data = []
        lift_points = [d['lift'] for d in data]
        for lift_point in optimize_points(lift_points[:], start_point):
            i = lift_points.index(lift_point)
            ordered_data.append(data[i])
        return ordered_data

    generate_gcode => ():
        """ Generate gcode output for this operation

        """
        cmds = []
        if self.disabled:
            return cmds
        try:

            job = self.parent
            fmt = job.format_value

            cmds.append("(Chamfer operation)")
            # Change tool
            if self.tool:
                cmds.extend(self.tool.generate_gcode())

            if not self.spindle_speed:
                raise ValueError(
                    "Spindle speed must be set for a chamfer operation."
                    "Use spindle_speed=value."
                )
            # Turn on spindle and coolant from base operation
            cmds.extend(Operation.generate_gcode(self))
            for child in self.children:
                if hasattr(child, 'generate_gcode'):
                    cmds.extend(child.generate_gcode(fmt))

            if self.coolant:
                # Turn off coolant
                cmds.append("M9")

            if self.spindle_speed:
                # Stop spindle it should have already retracted
                cmds.append("M5")

            cmds.append('') # Ensure newline
            return cmds
        except Exception as e:
            msg = f"(Error generating gcode: {e} for {self})"
            print(msg)
            traceback.print_exc()
            return [msg]

    Looper:
        iterable << [] if disabled else toolpath
        Part: path:

            func generate_gcode(fmt):
                cmds = []
                for child in self.children:
                    if isinstance(child, Polyline):
                        rapid = child.name == 'Rapid move'
                        cmds.extend(generate_polyline_gcode(child, fmt, rapid=rapid))
                    elif isinstance(child, Arc):
                        cmds.extend(generate_arc_gcode(child, fmt))
                    elif isinstance(child, Wire):
                        cmds.extend(generate_wire_gcode(child, fmt))
                return cmds

            Polyline:
                attr last_point = start_point if loop.index == 0 else toolpath[loop.index-1]['lift']
                name = 'Rapid move'
                line_style = 'dashed'
                color = 'lime'
                points = [
                    last_point,
                    loop.item['drop'],
                    loop.item['enter']
                ]

            Conditional:
                condition << loop.item['type'] == 'hole'
                Wire:
                    color = 'coral'
                    ArcEaseIn:
                        start_angle = loop.item['start_angle']
                        climb = operation.climb
                        path_start = loop.item['start']
                        enter_point = loop.item['enter']
                        arc_radius = loop.item['radius']

            TopoShape:
                color = 'magenta'
                shape = loop.item['path']

            Conditional:
                condition << loop.item['type'] == 'hole'
                Wire:
                    color = 'slateblue'
                    ArcEaseOut:
                        climb = operation.climb
                        start_angle = loop.item['start_angle']
                        path_end = loop.item['end']
                        exit_point = loop.item['exit']
                        arc_radius = loop.item['radius']

            Polyline:
                name = 'Rapid move'
                line_style = 'dashed'
                color = 'lime'
                func get_points():
                    pts = [loop.item['exit'], loop.item['lift']]
                    if loop.index + 1 == len(toolpath):
                        pts.append(end_point)
                    return pts
                points = get_points()
