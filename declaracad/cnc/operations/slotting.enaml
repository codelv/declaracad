from math import pi, atan2
from atom.api import Atom, Float, Instance, Property
from enaml.core.api import Conditional, Looper, Include
from declaracad.occ.geom import coerce_point
from declaracad.occ.api import (
    Arc, DisplayArrow, Part, Point, Polyline,  MiddlePath, TrimmedCurve,
    Topology, TopoShape, Wire
)
from declaracad.cnc.operation import Tool, Operation

from .trochoid import Trochoid


class SlottingData(Atom):
    tool = Instance(Tool)
    middle_path = Instance(MiddlePath)
    width = Float(strict=False)
    step_over = Float(strict=False)
    wire = Instance(Wire)
    def _get_path(self):
        return self.wire.render()

    path = Property(_get_path, cached=True)

    def compute_width(self, curve, t):
        return self.width - self.tool.diameter


enamldef SlotCutPath(Part): cut_path:
    attr tool: Tool
    attr data: SlottingData

    attr start_point = data.wire.topology.start_point
    attr last_point = start_point
    attr end_point << get_end_point()
    attr width
    attr simple_slot: bool = data.width == tool.diameter

    func get_end_point():
        if simple_slot:
            return data.wire.topology.end_point
        else:
            self.render()
            return self.last_point

    Include:
        objects = [data.wire] if simple_slot else []
    Looper:
        iterable = [] if simple_slot else Topology.parametrize_by_length(data.path, data.step_over)
        Polyline:
            color = 'lime'
            line_style = 'dashed'
            name = 'Rapid move'
            points = [
                last_point,
                trochoid.start_point
            ]
        Trochoid: trochoid:
            attr curve_d1 = Topology.curve_value_at(loop.item[0], loop.item[1], 1)
            tangent = curve_d1[1]
            center_point = curve_d1[0]
            width = cut_path.data.compute_width(*loop.item)
            attr a = atan2(data.step_over, width/2)
            enter_tangent = tangent.rotated(-pi/2+a) if loop.index > 0 else default_enter_tangent
            exit_tangent = tangent.rotated(pi/2+a)
            constructed :: cut_path.last_point = self.end_point


enamldef SlottingOperation(Operation): operation:
    """ Generates a Trochoidal toolpath of a slot through a part.

    """
    #: G-Code Heading
    operation_type = f"Slotting path {' '+ name if name else ''}"

    #: Shape to avoid
    #: This is typically the part model
    attr avoid

    #: List of faces to slot
    attr slot_width
    attr faces: list

    #: Amount
    attr step_over = tool.diameter * 0.10

    #: Clearance added to the offset.
    #: A positive number will leave extra stock between any walls
    #: A negative number will make take more stock away from the walls
    attr radial_clearance = 0

    #: Clearance added to the bottom of the hole
    #: A positive number will leave stock at the bottom
    #: A negative number will remove extra stock from the bottom
    attr bottom_clearance = 0

    #: Use climb milling
    attr climb: bool = True

    #: Distance to extend past the start and end when cutting an
    #: open ended slot
    attr extend_start = slot_width/2 + tool.diameter
    attr extend_end = slot_width/2 + tool.diameter

    # --------------------------------------------------------------------------
    # Speed and feed
    # --------------------------------------------------------------------------
    #: Slowdown factor
    attr slowdown_factor = 0.6

    #: Spindle speed calculation
    #: Assumes surface speed is in feet per minute
    spindle_speed = round(
        12 * surface_speed / (pi*tool.diameter/25.4) * slowdown_factor)

    #: Feedrate calculation
    feedrate = round(spindle_speed * tool.feed_per_rev, 2)

    # ------------------------------------------------------------------------
    # Internal variables
    # ------------------------------------------------------------------------
    #: Generated toolpath data
    attr toolpath = generate_toolpath()

    func get_distances(middle_path, edge):
        arc = middle_path.proxy.graph[edge]
        return (arc.FirstNode().Distance(), arc.SecondNode().Distance())

    func generate_toolpath():
        tool_radius = tool.diameter/2

        toolpath = []
        for face in self.faces:
            if bottom_clearance:
                face = Transform(
                    shape=face,
                    position=(0, 0, bottom_clearance)
                ).render()
            middle_path = MiddlePath(
                mode='not-touching',
                shapes=[face])
            middle_path.render()
            edges = []
            for edge in middle_path.topology.edges:
                d1, d2 = get_distances(middle_path, edge)
                topo = Topology(shape=edge)
                umin, umax = topo.curve_bounds
                u = umin - extend_start
                v = umax + extend_end
                curve = TrimmedCurve(shape=edge, u=u, v=v)
                edges.append(curve.render())

            data = SlottingData(
                tool=self.tool,
                middle_path=middle_path,
                width=self.slot_width - self.radial_clearance,
                step_over=self.step_over,
                wire=Wire(edges=edges)
            )
            toolpath.append(data)

        return toolpath

    Looper:
        iterable << [] if operation.disabled else operation.toolpath
        Part: path:
            attr slot_start = slot.start_point
            attr slot_end = slot.end_point
            attr drop_point = Point(slot_start.x, slot_start.y, start_point.z)
            attr lift_point = Point(slot_end.x, slot_end.y, start_point.z)

            Polyline:
                name = 'Rapid move'
                line_style = 'dashed'
                color = 'lime'
                points = [start_point, drop_point, slot_start]
                func generate_gcode(format_value):
                    cmds = []
                    for p in self.points[0:2]:
                        x, y, z = map(format_value, p)
                        cmds.append(f'G0 X{x} Y{y} Z{z}')
                    cmds.extend(operation.generate_spindle_start_gcode(format_value))
                    x, y, z = map(format_value, self.points[2])
                    cmds.append(f'G0 X{x} Y{y} Z{z}')
                    return cmds

            DisplayArrow: drop_arrow:
                color = 'red'
                cone_size = (0.6, 1.5)
                tube_size = (0.3, 3)
                description = 'Drop'
                direction = (0, 0, -1)
                position = drop_point + (0, 0, 3)
            SlotCutPath: slot:
                tool = operation.tool
                data = loop.item
            Polyline:
                name = 'Rapid move'
                line_style = 'dashed'
                color = 'lime'
                points = [slot_end, lift_point, start_point]
                func generate_gcode(format_value):
                    # Lift then stop spindle and move to start
                    cmds = []
                    for p in self.points[0:2]:
                        x, y, z = map(format_value, p)
                        cmds.append(f'G0 X{x} Y{y} Z{z}')
                    cmds.extend(operation.generate_spindle_stop_gcode(format_value))
                    x, y, z = map(format_value, self.points[2])
                    cmds.append(f'G0 X{x} Y{y} Z{z}')
                    return cmds
            DisplayArrow:
                color = 'green'
                cone_size = drop_arrow.cone_size
                tube_size = drop_arrow.tube_size
                description = 'Lift'
                direction = (0, 0, 1)
                position = lift_point
