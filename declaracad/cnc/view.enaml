from enaml.layout.api import vbox, hbox, align
from enaml.widgets.api import (
    Container, ObjectCombo, Menu, Action, Field, MultilineField, PushButton,
    PopupView, Label, ProgressBar
)
from enaml.application import deferred_call
from enaml.qt.QtCore import Qt
from enamlx.widgets.api import KeyEvent

from declaracad.core.api import DockItem, log
from declaracad.core.utils import load_icon
from declaracad.core.widgets import PlainTextEdit

from .plugin import CncPlugin, Device, Job


enamldef NotificationPopup(PopupView):
    foreground = 'white'
    background = 'rgba(30, 30, 30, 0.85)'
    window_type = 'tool_tip'
    parent_anchor = (0.0, 0.0)
    anchor = (0.0, 0.0)
    offset = (10, 10)
    timeout = 5
    fade_in_duration = 200
    fade_out_duration = 200
    attr message: str = ""
    Container:
        Label:
            foreground = 'white'
            text << message
            align = 'left'


async def try_connect(view: "CommView"):
    # Separate function because async func does not work with iscoroutine
    try:
        await view.device.connect()
        view.show_notification("Connected!", timeout=1)
    except Exception as e:
        view.show_notification(f"Connection error: {e}")


enamldef CommView(Container): view:
    attr plugin: CncPlugin
    attr device: Device := plugin.device
    attr history_index: int = -1
    attr history_limit: int = 40
    attr notification: NotificationPopup = None
    attr job: Job := plugin.job
    attr locked: bool << device and device.busy
    attr connected: bool << bool(device and device.connected)
    initialized ::
        # On startup observe the device's last output
        if device:
            device.observe('last_read', watch_output)
            device.observe('last_write', watch_input)

    device ::
        # When the device device changes, cleanup, and observe the new last output
        old = change['oldvalue']
        new = change['value']
        if old:
            old.unobserve('last_read', watch_output)
            old.unobserve('last_write', watch_input)
        if new:
            new.observe('last_read', watch_output)
            new.observe('last_write', watch_output)

    func watch_output(change):
        if plugin.output_enabled:
            self.append_message(change['value'])

    func watch_input(change):
        if plugin.input_enabled:
            self.append_message(change['value'])

    func append_message(value: bytes):
        """ Decode and add the message to the log output view """
        try:
            msg = value.decode()
            comm_log.append(msg.strip() if plugin.strip_whitespace else msg)
            if plugin.autoscroll:
                comm_log.scroll_to_end()
        except Exception as e:
            log.debug(e)

    func send_text():
        if device and device.connected:
            msg = to_send.text
            if not msg:
                return
            # Add to history
            add_to_history(msg)
            if plugin.add_newline:
                msg += "\r\n"
            deferred_call(device.write, msg)
            to_send.text = ""
        else:
            show_notification("Not connected")

    func add_to_history(text: str):
        if text:
            # Retain order (most recent first)
            if text in plugin.history:
                plugin.history.remove(text)
            plugin.history.append(text)

            # Keep the size limited
            if len(plugin.history) > history_limit:
                plugin.history.pop(0)
        # Reset
        view.history_index = 0

    func hide_notification():
        """ Hide the previous notification message if any """
        if self.notification:
            self.notification.close()

    func show_notification(message: str, **kwargs):
        """ Display a notification message.

        Parameters
        ----------
        message: String
            The message to show

        """
        self.hide_notification()
        log.info(f"CNC Notification: {message}")
        popup = NotificationPopup(self, message=message, **kwargs)
        popup.show()
        self.notification = popup

    Container:
        constraints = [
            vbox(hbox(cmb_conn, btn_open, btn_clear, btn_autoscroll),
                comm_log,
                hbox(progress_bar, job_status, btn_job),
                hbox(to_send, btn_send)),
            align('v_center', cmb_conn, btn_open, btn_clear, btn_autoscroll),
            align('v_center', progress_bar, job_status, btn_job),
            align('v_center', to_send, btn_send),
        ]

        ObjectCombo: cmb_conn:
            items << [None] + plugin.devices
            to_string = lambda d: d.name if d else ""
            selected := view.device
        PushButton: btn_open:
            #text << "Close" if opened else "Open"
            icon << load_icon("disconnect" if connected else "connect")
            tool_tip << "Connected. Click to disconnect" if connected else "Disconnected. Click to Connect"
            clicked ::
                if connected:
                    device.busy = False # Force send to quit
                    deferred_call(device.disconnect)
                else:
                    deferred_call(try_connect, view)
        PushButton: btn_clear:
            icon = load_icon("bin")
            tool_tip = "Clear console"
            clicked :: comm_log.clear()
        PushButton: btn_autoscroll:
            icon << load_icon("lock_open") if plugin.autoscroll else load_icon("lock")
            tool_tip = "Auto scroll"
            checkable = True
            checked := plugin.autoscroll
        PlainTextEdit: comm_log:
            hug_height = 'weak'
            hug_width = 'weak'
        ProgressBar: progress_bar:
            visible << job is not None
            value << int(job.progress) if job else 0
        Label: job_status:
            visible << job is not None
            tool_tip = "Job progress"
            text << f"{job.current_line} / {job.line_count}" if job else ""
        PushButton: btn_job:
            visible << job is not None
            text << "Abort" if job and job.status == "running" else "Close"
            tool_tip = "Job actions"
            clicked ::
                if job.status == "running":
                    job.abort()
                else:
                    plugin.job = None

        Field: to_send:
            enabled << connected and not locked
            placeholder <<
                if not connected:
                    return "Disconnected... reconnect first."
                elif locked:
                    return "Sending file.. please wait."
                return "Enter a command.."
            tool_tip = "Press enter to send"
            KeyEvent:
                released ::
                    code = change['value']['code']
                    if locked:
                        pass
                    elif code == Qt.Key_Return:
                        send_text()
                    elif len(plugin.history):
                        if code == Qt.Key_Up:
                            n = len(plugin.history)
                            view.history_index = max(-n, history_index-1)
                            to_send.text = plugin.history[view.history_index]
                        elif code == Qt.Key_Down:
                            view.history_index = min(0, history_index+1)
                            if view.history_index == 0:
                                to_send.text = ""
                            else:
                                to_send.text = plugin.history[view.history_index]

        PushButton: btn_send:
            text = "Send"
            enabled << connected and not locked
            clicked :: send_text()



enamldef ComChannelDockItem(DockItem): dock_item:
    title = "Channel"
    name = f"com-channel-{id(self)}"
    icon = load_icon("disconnect")
    title_bar_right_clicked :: menu.popup()
    CommView:
        padding = 0
        plugin << dock_item.plugin
