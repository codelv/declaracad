import traceback
from math import ceil, sqrt
from typing import List as ListType
from atom.api import Atom, Bool, Enum, Float, Instance, Str
from datetime import datetime
from declaracad.occ.geom import coerce_point
from declaracad.occ.api import (
    DisplayArrow, Point, Part, Polyline, Topology, Vertex, Wire, Arc,
    HalfSpace, Cylinder, Timer, Looper, Include, Conditional
)
from declaracad.cnc.optimize import optimize_points
from declaracad.cnc.cutters import Tool
from enaml.core.declarative import d_, d_func



def generate_arc_gcode(
    arc: Arc,
    format_value,
    incremental: bool = True
) -> ListType[str]:
    """ Generate gcodee for an Arc """

    cmds = []
    d = arc.direction
    center = arc.position
    start, end = arc.points
    delta = center - start if incremental else center
    x, y, z = map(format_value, end)
    if d == (0, 0, 1) or d == (0, 0, -1):
        axis = 2
        if arc.clockwise:
            code = 'G3' if d[axis] == -1 else 'G2'
        else:
            code = 'G3' if d[axis] == 1 else 'G2'
        # XY plane
        i, j = format_value(delta.x), format_value(delta.y)
        cmds.append(f'{code} X{x} Y{y} Z{z} I{i} J{j}')
    elif d == (0, 1, 0) or d == (0, -1, 0):
        axis = 1
        if arc.clockwise:
            code = 'G3' if d[axis] == -1 else 'G2'
        else:
            code = 'G3' if d[axis] == 1 else 'G2'
        # XZ plane
        i, k = format_value(delta.x), format_value(delta.z)
        cmds.append("G18 (XZ-plane)")
        cmds.append(f'{code} X{x} Z{z} Y{y} I{i} K{k}')
        cmds.append('G17 (XY-plane)') # Restore G17
    elif d == (1, 0, 0) or d == (-1, 0, 0):
        axis = 0
        if arc.clockwise:
            code = 'G3' if d[axis] == -1 else 'G2'
        else:
            code = 'G3' if d[axis] == 1 else 'G2'

        # YZ plane
        j, k = format_value(delta.y), format_value(delta.z)
        cmds.append("G19 (YZ-plane)")
        cmds.append(f'{code} Y{y} Z{z} X{x} J{j} K{k}')
        cmds.append('G17 (XY-plane)') # Restore G17
    else:
        raise NotImplementedError(f"Arc direction {d} cannot be converted")

    if not arc.description:
        arc.description = "Gcode: \n%s\n" % '\n'.join(cmds)

    return cmds

def generate_polyline_gcode(
    polyline: Polyline,
    format_value,
    rapid: bool = False
) -> ListType[str]:
    """ Generate gcodee for a Polyline """
    cmds = []
    code = 'G0' if rapid else 'G1'
    for p in polyline.points:
        x, y, z = map(format_value, p)
        cmds.append(f'{code} X{x} Y{y} Z{z}')
    return cmds

class Operation(Part):
    """ A single machining operation.

    """
    #: Set to True to disable this operation
    disabled = d_(Bool())

    #: Cutting tool
    tool = d_(Instance(Tool))

    #: Spindle control
    #: If zero off, if positive, CW, if negative CCW
    spindle_speed = d_(Float(strict=False))

    #: Dwell after spindle speed to allow time for ramp up/down
    spindle_dwell = d_(Float(1.0, strict=False))

    #: Coolant control
    #: If mist or flood on, otherwise off
    coolant = d_(Enum('', 'mist', 'flood'))

    #: Generated gcode
    gcode = d_(Str())

    @d_func
    def generate_gcode(self) -> ListType[str]:
        cmds = []
        job = self.parent
        if self.spindle_speed:
            s = abs(self.spindle_speed)
            mcode = 'M3' if self.spindle_speed > 0 else 'M3'
            cmds.append(f'S{s} {mcode}')

            if self.spindle_dwell:
                pause = job.format_value(self.spindle_dwell)
                cmds.append(f'P{pause}') # Wait for spindle to ramp up

        if self.coolant == 'mist':
            cmds.append('M7')
        elif self.coolant == 'flood':
            cmds.append('M8')
        else:
            cmds.append(f'M9')

        return cmds

    def _default_gcode(self):
        return '\n'.join(self.generate_gcode())

    def _default_description(self):
        return "G-Code: \n" + self.gcode[0:100]


enamldef DrillingCycle(Operation): operation:
    """ Perform a peck drilling cycle using a G73, G81, G82, or G83 G-Code.

    All values are in mm. Use the job to convert to inches.

    """

    #: List of circular edges, cylinder faces, or points
    attr holes: list = []

    #: A point or tuple
    attr start_point

    #: A point or tuple
    attr end_point = start_point

    # ------------------------------------------------------------------------
    # Operation options
    # ------------------------------------------------------------------------
    #: Feedrate F
    attr feedrate = 0

    #: Retract value R
    attr retract = 1.0

    #: Depth of hole Z
    attr depth = 0.0

    #: Dwell time
    attr dwell = 0

    #: Peck amount Q
    #: If non-zero it will use a G73 or G83.
    #: Otherwise it will use a G81 or G82 (based on dwell)
    attr peck = 1.0 # TODO: Compute based on tool radius?

    #: Retract to R after each peck.
    #: If True this uses a G83, otherwise it uses a G73
    attr full_retract: bool = False

    # ------------------------------------------------------------------------
    # Display options
    # ------------------------------------------------------------------------
    attr vertex_color: str = "yellow"

    # ------------------------------------------------------------------------
    # Internal variables
    # ------------------------------------------------------------------------
    attr lift_point = get_lift_point()
    attr drop_point = get_drop_point()
    attr hole_positions << [get_center(h) for h in holes]
    attr optimized_positions << optimize_points(hole_positions, start_point)
    attr path = generate_path()

    func get_center(hole):
        """ Find center position of a hole
        """
        if isinstance(hole, Point):
            return hole
        elif Topology.is_cylinder(hole):
            s = Topology.cast_surface(hole).Cylinder()
        elif Topology.is_circle(hole):
            s = Topology.cast_curve(hole)
        else:
            raise ValueError(f"Cannot get center of {hole}")
        return Point(s.Location())

    func get_lift_point():
        last_point = self.optimized_positions[-1]
        z = coerce_point(start_point).z
        return Point(last_point.x, last_point.y, z)

    func get_drop_point():
        first_point = coerce_point(self.optimized_positions[0])
        z = coerce_point(start_point).z
        return Point(first_point.x, first_point.y, z)

    func generate_path():
        """ Generate the path to display including the drilling cycle options.

        """
        path = [coerce_point(start_point), drop_point]
        steps = int(ceil(abs((retract-depth) / peck))) if peck else 0
        for p in self.optimized_positions:
            retract_pos = Point(p.x, p.y, retract)
            bottom_pos = Point(p.x, p.y, depth)

            # Go to top of hole
            path.append(retract_pos)

            # Start pecking
            z = retract_pos.z - peck
            for step in range(steps):
                step_pos = Point(p.x, p.y, max(z, bottom_pos.z))
                if full_retract:
                    return_pos = retract_pos
                else:
                    return_pos = Point(p.x, p.y, step_pos.z+peck)
                path.append(step_pos)
                path.append(return_pos)
                z -= peck

            # Go to bottom
            path.append(bottom_pos)
            # Return to top
            path.append(retract_pos)

        path.append(lift_point)
        path.append(coerce_point(end_point))
        return path

    generate_gcode => ():
        """ Generate gcode output for this operation

        """
        cmds = []
        if self.disabled:
            return cmds
        try:
            # Change tool
            if self.tool:
                cmds.extend(self.tool.generate_gcode())

            if not self.spindle_speed:
                raise ValueError(
                    "Spindle speed must be set for a drilling cycle."
                    "Use spindle_speed=value."
                )

            job = self.parent
            fmt = job.format_value
            p = self.path[0]
            d = fmt(depth)
            r = fmt(retract)
            cmds.append("(Drilling cycle)")

            # Move to top of first hole
            for p in self.path[0:2]:
                cmds.append(f'G0 X{fmt(p.x)} Y{fmt(p.y)} Z{fmt(p.z)}')

            # Turn on spindle and coolant from base operation
            cmds.extend(Operation.generate_gcode(self))

            if peck:
                code = 'G83' if full_retract else 'G73'
            elif dwell:
                code = 'G82'
            else:
                code = 'G81'

            if code == 'G73' and dwell:
                raise ValueError("Cannot use dwell with G73. Disable dwell or use full_peck=True")

            for p in self.optimized_positions:
                cmd = [
                    'G90', # Absolute
                    code,
                    'G98',
                    f'X{fmt(p.x)}',
                    f'Y{fmt(p.y)}',
                    f'Z{d}',
                    f'R{r}',
                ]
                if peck:
                    cmd.append(f'Q{fmt(peck)}')
                if dwell:
                    cmd.append(f'P{dwell}')
                if feedrate:
                    cmd.append(f'F{feedrate}')
                cmds.append(' '.join(cmd))

            if self.coolant:
                # Turn off coolant
                cmds.append("M9")

            if self.spindle_speed:
                # Stop spindle it should have already retracted
                cmds.append("M5")

            # Add lift and return point
            for p in self.path[-2:]:
                cmds.append(
                    f'G0 X{fmt(p.x)} Y{fmt(p.y)} Z{fmt(p.z)}'
                )
            cmds.append('') # Ensure newline
            return cmds
        except Exception as e:
            msg = f"(Error generating gcode: {e} for {self})"
            print(msg)
            traceback.print_exc()
            return [msg]

    Conditional:
        condition << not operation.disabled
        Looper:
            iterable << optimized_positions
            Vertex:
                color = vertex_color
                position = (loop.item.x, loop.item.y, retract)
        Polyline:
            color = operation.color
            points << path
        DisplayArrow: drop_arrow:
            color = 'red'
            cone_size = (0.6, 1.5)
            tube_size = (0.3, 3)
            description = 'Drop'
            direction = (0, 0, -1)
            position = drop_point + (0, 0, 3)
        DisplayArrow:
            color = 'green'
            cone_size = drop_arrow.cone_size
            tube_size = drop_arrow.tube_size
            description = 'Lift'
            direction = (0, 0, 1)
            position = lift_point


enamldef ArcHelix(Part): part:
    """ Utility for creating a helix using arcs.

    """
    #: Radius of helix
    attr radius

    #: Height of helix
    #: This can be ignored if the pitch and revolutions are given
    attr height

    #: Maximum pitch
    #: If height is given calculate the pitch to reach the given height
    attr max_pitch

    # ------------------------------------------------------------------------
    # Calculated Inputs
    # ------------------------------------------------------------------------
    #: Actual pitch used
    attr pitch = calculate_pitch(self.height, self.max_pitch)

    #: Revolutions
    attr revolutions = int(self.height/self.pitch)

    # ------------------------------------------------------------------------
    # G Code Options
    # ------------------------------------------------------------------------

    #: Feedrate used for gcode
    attr feedrate = 0

    #: Clockwise helix
    attr clockwise: bool = True

    #: Use incremental arc commands
    attr incremental: bool = True

    attr gcode: str = generate_gcode()

    func generate_gcode():
        cmds = []
        code = 'G2' if self.clockwise else 'G3'
        pos = self.position
        if self.feedrate:
            cmds.append(f"F{self.feedrate}")
        for arc in helix.children:
            if not isinstance(arc, Arc):
                continue
            center = arc.position + pos
            start = arc.points[0] + pos[0:2]
            end = arc.points[-1] + pos[0:2] # Ingore Z
            delta = center - start if incremental else center
            i = format_value(delta.x)
            j = format_value(delta.y)
            x = format_value(end.x)
            y = format_value(end.y)
            z = format_value(center.z + pitch/4) # Arc is centered at pitch/2
            cmd = f'{code} X{x} Y{y} Z{z} I{i} J{j}'
            cmds.append(cmd)
        return cmds

    func calculate_pitch(height, max_pitch):
        """ Determine actual pitch to reach the desired depth
        using helix_pitch as the maximum value.
        """
        r = height/max_pitch
        if r <= 1:
            # Depth is less than one pitch so adjust
            # pitch to just do one revolution
            return height
        n = int(r)
        if n == r:
            # Max pitch is a multiple of the depth
            return max_pitch
        # Solve n + 1 = height / new_pitch
        if n & 1:
            new_pitch = height/(n+1)
        else:
            new_pitch = height/(n+2) # Force even number of revolutions
        assert new_pitch < max_pitch
        return new_pitch

    Wire: helix:
        color = parent.color
        name = 'ArcHelix'

        # Desired radius in x y plane
        attr a = radius

        # Step down of quarter of a  revolution
        attr b = pitch/4
        attr arc_radius = sqrt(radius**2+b**2)
        attr cw = 1 if clockwise else -1

        Looper:
            iterable = range(int(revolutions*2))
            Arc:
                #color = 'blue' if loop.index & 1 else 'red'
                radius = arc_radius
                attr dz = loop.index*pitch/2
                attr rot = -cw if loop.index & 1 else cw
                direction = (rot*-b, 0, a)
                clockwise = part.clockwise
                position = (0, 0, -b-dz)
                points = [(rot * radius, 0), (rot * -radius, 0)]


enamldef ArcSpiral(Part): part:
    """ Create an archimedean spiral in the xy plane

    """

    #: Starting radius
    attr start_radius

    #: Stopping radius
    attr end_radius

    #: Step over amount
    attr max_step_over

    #: Description
    description = f'Arc spiral start {start_radius}, end {end_radius}, step over {step_over}'

    # ------------------------------------------------------------------------
    # Internal variables
    # ------------------------------------------------------------------------

    #: Calculated step over amount. Will always be less than or equal to
    #: max_step_over.
    attr step_over = calculate_step_over(start_radius, end_radius, max_step_over)

    #: Change in radius
    attr dr = end_radius - start_radius
    attr path = generate_path()

    # ------------------------------------------------------------------------
    # G Code Options
    # ------------------------------------------------------------------------

    #: Feedrate used for gcode
    attr feedrate = 0

    #: Clockwise spiral
    attr clockwise: bool = True
    attr incremental: bool = True

    attr gcode: str = generate_gcode()

    func generate_gcode():
        cmds = []
        code = 'G2' if self.clockwise else 'G3'
        pos = self.position
        if self.feedrate:
            cmds.append(f"F{self.feedrate}")
        for arc in spiral.children:
            if not isinstance(arc, Arc):
                continue
            center = arc.position + pos
            start = arc.points[0] + pos[0:2]
            end = arc.points[-1] + pos[0:2] # Ingore Z
            delta = center - start if incremental else center
            i = format_value(delta.x)
            j = format_value(delta.y)
            x = format_value(end.x)
            y = format_value(end.y)
            cmd = f'{code} X{x} Y{y} I{i} J{j}'
            cmds.append(cmd)
        return cmds

    func calculate_step_over(r1, r2, max_step):
        """ Adjust step over so it lands exactly on the end radius

        """
        rmin = min(r1, r2)
        rmax = max(r1, r2)
        delta = rmax-rmin
        r = delta/max_step
        if r <= 1:
            # Do one revoluation
            return delta
        n = int(r)
        if n == r:
            # Stepover is multiple of max step
            return max_step
        # Solve n + 1 = delta/new_step
        if n & 1:
            new_step_over = delta/(n+1)
        else:
            new_step_over = delta/(n+2) # Force even number of steps
        assert new_step_over < max_step
        return new_step_over

    func generate_path():
        steps = int(dr/step_over)
        arcs = []
        r = start_radius
        arcs.append((start_radius, 0, 1))
        for i in range(steps):
            r += step_over
            if i & 1:
                x = 0
                direction = 1
            else:
                x = step_over
                direction = -1

            arcs.append((r, x, direction))

        #assert r == end_radius

        # Add full circle
        arcs.append((end_radius, 0, -1))
        arcs.append((end_radius, 0, 1))

        return arcs
    Wire: spiral:
        color = parent.color
        name = 'ArcSpiral'
        Looper:
            iterable = path
            Arc:
                attr rot = loop.item[2]
                radius = loop.item[0]
                clockwise = part.clockwise
                position = (loop.item[1], 0)
                points = [(rot*radius, 0), (-rot*radius, 0)]


class CircularPocketData(Atom):
    radius = Float(strict=False)
    center = Instance(Point)
    top = Instance(Point)
    bottom = Instance(Point)


enamldef CircularPocket(Operation): operation:
    """ Circular pocket does a helix down to the bottom of the hole
    or step limit, then performs an archimedean spiral out to the
    cylinder radius - tool.radius. Repeating for each step as needed based on
    the tool's cutter dimension.

    """
    #: List of faces to pocket
    attr pockets: list = []
    attr feedrate = 0
    attr step_down = 1

    attr start_point
    attr end_point = start_point

    #: Clearance added to start above the top
    attr top_clearance = 1

    #: Clearance added to the bottom of the hole
    #: A positive number will leave stock at the bottom
    #: A negative number will remove extra stock from the bottom (if closed)
    attr bottom_clearance = 0

    #: Clearance added to the diameter.
    #: A positive number will make the cut diameter bigger.
    #: A negative number will make it smaller
    attr radial_clearance = 0

    #: Helix radius
    attr helix_radius = tool.diameter*1/3

    # Change in z per revolution of helix
    attr helix_pitch = tool.diameter * 0.06

    #: Spiral step over
    attr step_over = tool.diameter * 0.06

    #: Internal pocket data
    attr data = [validate_data(get_pocket_data(p)) for p in pockets]

    func validate_data(pocket_data: CircularPocketData):
        """ Make sure the tool can be used

        """
        cut_diameter = pocket_data.radius * 2
        helix_diameter = 2*helix_radius
        if cut_diameter < (tool.diameter + helix_diameter):
            #: TODO: What about helix radius??
            raise ValueError(
                f"The tool {tool.description} is too large to cut "
                f"a {cut_diameter} diameter pocket. Use a smaller tool "
                f"or decrease the helix radius.")
        return pocket_data

    func get_pocket_data(shape):
        """ Create CircularPocketData from a cylindrical surface or a tuple
        of cylindrical surface and the bottom depth, surface, or edge of the pocket.

        """
        if isinstance(shape, CircularPocketData):
            return shape
        if isinstance(shape, dict):
            return CircularPocketData(**shape)

        bottom_edge_or_surface = None
        if isinstance(shape, (tuple, list)):
            shape, bottom_edge_or_surface = shape
        if Topology.is_cylinder(shape):
            surface = Topology.cast_surface(shape)
            cylinder = surface.Cylinder()
            radius = cylinder.Radius()
            center = Point(cylinder.Location())
            vertices = [Point(v) for v in Topology(shape=shape).vertices]
            bottom = min([v.z for v in vertices])
            top = max([v.z for v in vertices])
        else:
            raise ValueError("Pocket must be a cylindrical face")

        if bottom_edge_or_surface is not None:
            if isinstance(bottom_edge_or_surface, (float, int)):
                bottom = min(bottom, bottom_edge_or_surface)
            elif Topology.is_circle(bottom_edge_or_surface):
                bottom_edge = Topology.cast_curve(bottom_edge_or_surface)
                bottom = min(bottom, Point(bottom_edge.Location()).z)
            else:
                raise ValueError("Pocket bottom must be a depth or cirular edge")
        return CircularPocketData(
            radius=radius + radial_clearance / 2,
            center=center,
            bottom=Point(center.x, center.y, bottom + bottom_clearance),
            top=Point(center.x, center.y, top + top_clearance),
        )

    generate_gcode => ():
        cmds = []
        if self.disabled:
            return cmds
        try:
            # Change tool
            cmds.append("(Circular pocket)")

            if self.tool:
                cmds.extend(self.tool.generate_gcode())

            if not self.spindle_speed:
                raise ValueError(
                    "Spindle speed must be set for a cylindrical pocket."
                    "Use spindle_speed=value."
                )

            job = self.parent
            fmt = job.format_value
            for child in self.children:
                if hasattr(child, 'generate_gcode'):
                    cmds.extend(child.generate_gcode())


            if self.coolant:
                # Turn off coolant
                cmds.append("M9")

            if self.spindle_speed:
                # Stop spindle it should have already retracted
                cmds.append("M5")

            p = coerce_point(end_point)
            cmds.append(
                f'G0 X{fmt(p.x)} Y{fmt(p.y)} Z{fmt(p.z)}'
            )

            cmds.append('') # Ensure Add newline
            return cmds
        except Exception as e:
            msg = f"(Error generating gcode: {e} for {self})"
            print(msg)
            traceback.print_exc()
            return [msg]
    Conditional:
        condition << not operation.disabled
        Looper:
            iterable << operation.data
            Part:
                attr outside_radius = loop.item.radius - tool.diameter/2
                attr start_point = coerce_point(operation.start_point)
                attr center = loop.item.center
                attr drop_point = Point(center.x, center.y, start_point.z)
                attr lift_point = Point(arc_up.points[-1].x, arc_up.points[-1].y, drop_point.z)
                attr top_point = loop.item.top
                attr bottom_point = loop.item.bottom
                attr depth = top_point.z - bottom_point.z
                attr arc_start = top_point + (0, 0, helix_radius/4)
                name = 'Pocket'

                func generate_gcode():
                    cmds = []
                    for child in self.children:
                        if hasattr(child, 'generate_gcode'):
                            cmds.extend(child.generate_gcode())
                        elif isinstance(child, Arc):
                            cmds.extend(generate_arc_gcode(child, format_value))
                        elif isinstance(child, Polyline):
                            cmds.extend(generate_polyline_gcode(
                                child, format_value, rapid=True))
                    return cmds

                DisplayArrow: drop_arrow:
                    color = 'red'
                    cone_size = (0.6, 1.5)
                    tube_size = (0.3, 3)
                    description = 'Drop'
                    direction = (0, 0, -1)
                    position = drop_point + (0, 0, 3)

                # Heliz down to bottom of hole or max step
                Vertex:
                    color = 'lime'
                    description = 'Top of circular pocket'
                    position = top_point
                Vertex:
                    description = 'Bottom of circular pocket'
                    color = 'blue'
                    position = bottom_point
                Polyline: move_to_point:
                    points = [start_point, drop_point, arc_start]

                Arc: arc_in:
                    # Arc into center
                    color = 'purple'
                    name = 'Arc in'
                    direction = (1, 0, 0)
                    radius = helix_radius/4
                    position = top_point + (0, radius, radius)
                    points = [
                        top_point+(0, 0, radius),
                        top_point+(0, radius, 0)
                    ]

                Arc: arc_merge:
                    color = 'teal'
                    name = 'Arc merge'
                    attr p = arc_in.points[-1]
                    attr r = arc_in.radius
                    position = p + (r, 0)
                    clockwise = True
                    radius = r
                    points = [
                        p,
                        p + (r, r)
                    ]

                Arc: arc_union:
                    color = 'teal'
                    name = 'Arc union'
                    attr p = arc_merge.points[-1]
                    clockwise = True
                    position = top_point + (arc_merge.radius, 0)
                    radius = arc_merge.radius*2
                    points = [
                        p,
                        top_point + (arc_merge.radius * 2, 0)
                    ]


                ArcHelix: helix:
                    color = 'green'
                    radius = helix_radius*3/4
                    max_pitch = helix_pitch
                    height = depth
                    position = top_point
                    feedrate = operation.feedrate

                ArcSpiral: spiral:
                    name = 'Spiral'
                    color = 'purple'
                    position = bottom_point
                    start_radius = helix_radius*3/4
                    end_radius = outside_radius
                    max_step_over = operation.step_over
                    feedrate = operation.feedrate

                Arc: arc_out:
                    color = 'orange'
                    name = 'Arc out'
                    radius = helix_radius/4
                    direction = (0, 0, -1)
                    # Spiral end point
                    attr p = bottom_point + (-spiral.end_radius, 0)
                    position = p + (radius, 0)
                    points = [
                        p,
                        p + (radius, radius)
                    ]

                Arc: arc_up:
                    color = 'orange'
                    name = 'Arc up'
                    direction = (0, -1, 0)
                    radius = arc_out.radius
                    # Spiral end point
                    attr p = arc_out.points[-1]
                    position = p + (0, 0, radius)
                    points = [p, position + (radius, 0)]

                Polyline:
                    name = 'Return path'
                    attr p = arc_up.points[-1]
                    points = [p, lift_point, end_point]

                DisplayArrow: lift_arrow:
                    color = 'green'
                    cone_size = drop_arrow.cone_size
                    tube_size = drop_arrow.tube_size
                    description = 'Lift'
                    direction = (0, 0, 1)
                    position = lift_point


enamldef FacingOperation(Operation):
    """ A multi-layer Zig-zag facing operation.

    This does not (currently) support hole avoidance.

    """
    #: The face to clear
    attr face

    #: Total depth to cut
    attr cut_depth

    # ------------------------------------------------------------------------
    # Toolpath parameters
    # ------------------------------------------------------------------------

    #: Height to clear above
    attr clearance_height = 5

    #: Stock to leave above face
    attr top_clearance = 0

    #: Height to lift up when moving from end to start of next layer
    attr feed_height = 5

    #: Amount to step over
    attr step_over = tool.diameter*0.9

    #: Distance to cut each step
    attr step_down = cut_depth

    #: Amount to go past the edge of the face
    attr step_past = tool.diameter/4

    attr start_point
    attr end_point = start_point

    # ------------------------------------------------------------------------
    # Internal variables
    # ------------------------------------------------------------------------
    attr first_point = toolpath[0][0][1]
    attr drop_point = Point(first_point.x - lead_in_radius, first_point.y, coerce_point(start_point).z)

    #: Radius of lead in arc
    attr lead_in_radius = 5

    #: Bounding box of the face
    attr bounding_box = Topology.bbox(face)

    #: Generated toolpath
    attr toolpath = generate_toolpath(face)

    func generate_toolpath(face):
        if face is None:
            raise ValueError("A face must be given")
        ymin = bounding_box.ymin
        ymax = bounding_box.ymax

        topo = Topology(shape=face)

        i = 0
        last = None
        shift = Point(0, -tool.diameter/2)
        #shift = Point(0, 0)

        z = top_clearance + bounding_box.zmin + cut_depth
        zmin = z - cut_depth
        layers = []
        while z > zmin:
            points = []
            z = max(z-step_down, zmin)
            y = ymin

            start_shift = shift + (step_past, 0)
            end_shift = shift + (-step_past, 0)
            while y <= ymax:
                i += 1
                y += step_over

                # Just use bbox
                start_point = Point(bounding_box.xmax, y, z) + start_shift
                end_point = Point(bounding_box.xmin, y, z) + end_shift


                # Find edge intersections
                #space = HalfSpace(position=(0, y, 0), direction=(0, 1, 0))
                #results = topo.intersection(space.render())

                #if results:
                    #TODO: To handle avoidance regions intersections here...
                    #if len(results) != 1:
                       #raise NotImplementedError("TODO: Handle islands")
                    #start_point = end_point = None
                    #for r in results:
                        #line = Topology.cast_curve(r)
                        #p0 = Topology.get_value_at(line, line.FirstParameter()) + start_shift
                        #p1 = Topology.get_value_at(line, line.LastParameter()) + end_shift

                        #Use point with min x as start point
                        #TODO: IDK why this is switched but whatever
                        #if start_point is None or p0.x > start_point.x:
                            #start_point = p0
                        #if end_point is None or p1.x < end_point.x:
                            #end_point = p1

                #elif i > 1 and y > ymax:
                    #If it goes past the end there will be no intersection
                    #so add it anyways for the last pass
                    #start_point = start_point + (0, step_over, 0)
                    #end_point = end_point + (0, step_over, 0)

                #start_point.z = z
                #end_point.z = z

                if i & 1 == 0:
                    item = [last, start_point, end_point]
                else:
                    item = [last, end_point, start_point]
                last = item[-1]
                points.append(item)
            layers.append(points)
        return layers

    generate_gcode => ():
        """ Generate gcode output for this operation

        """
        cmds = []
        if self.disabled:
            return cmds
        try:

            job = self.parent
            fmt = job.format_value

            cmds.append("(Facing operation)")
            # Change tool
            if self.tool:
                cmds.extend(self.tool.generate_gcode())

            if not self.spindle_speed:
                raise ValueError(
                    "Spindle speed must be set for a facing cycle."
                    "Use spindle_speed=value."
                )
            # Turn on spindle and coolant from base operation
            cmds.extend(Operation.generate_gcode(self))
            for child in self.children:
                if isinstance(child, Polyline):
                    rapid = child.name == 'Rapid move'
                    cmds.extend(generate_polyline_gcode(child, fmt, rapid=rapid))
                elif isinstance(child, Arc):
                    cmds.extend(generate_arc_gcode(child, fmt))

            if self.coolant:
                # Turn off coolant
                cmds.append("M9")

            if self.spindle_speed:
                # Stop spindle it should have already retracted
                cmds.append("M5")

            cmds.append('') # Ensure newline
            return cmds
        except Exception as e:
            msg = f"(Error generating gcode: {e} for {self})"
            print(msg)
            traceback.print_exc()
            return [msg]

    Conditional:
        condition << not disabled
        DisplayArrow: drop_arrow:
            color = 'red'
            cone_size = (0.6, 1.5)
            tube_size = (0.3, 3)
            description = 'Drop'
            direction = (0, 0, -1)
            position = drop_point + (0, 0, 3)

        Polyline: move_in:
            name = 'Rapid move'
            color = 'lime'
            points = [start_point, drop_point, lead_in_arc.points[0]]

        Arc: lead_in_arc:
            #attr s = move_in.points[-1]
            name = 'Lead in arc'
            color = 'orange'
            radius = lead_in_radius
            clockwise = True
            position = first_point + (0, 0, radius)
            points = [
                first_point + (-radius, 0, radius),
                first_point
            ]
            direction = (0, 1, 0)

        Looper: layer_looper:
            iterable = toolpath
            Conditional: connection_line:
                # This block is the connection line between two layers
                # If not the first layer draw a connection between this layer and the last
                condition = loop.index > 0
                # Section between layers
                attr arc_radius = min(lead_in_radius, step_over/2)
                attr arc_count = len(loop.item) * loop.index
                attr dx = arc_radius if arc_count & 1 else -arc_radius

                Arc: exit_arc:
                    attr start_point = loop.item[0][0]
                    attr end_point = start_point + (connection_line.dx, 0, radius)
                    direction = (0, 1, 0)
                    clockwise = connection_line.arc_count & 1 == 1
                    name = f'Layer connection lift arc {arc_count}'
                    radius = connection_line.arc_radius
                    color = 'purple'
                    position = (start_point.x, start_point.y, end_point.z)
                    points = [start_point, end_point]
                Arc: exit_turn_arc:
                    # Arc that smoothly re-joins the layer exit arc and rapid across
                    attr start_point = exit_arc.points[-1]
                    attr end_point = start_point + (0, -radius, radius)
                    direction = (1, 0, 0)
                    radius = exit_arc.radius
                    color = 'purple'
                    name = f'Layer connection exit turn arc {exit_arc.arc_count}'
                    position = (start_point.x, end_point.y, start_point.z)
                    points = [start_point, end_point]

                Conditional:
                    condition = exit_turn_arc.points[-1] != enter_turn_arc.points[0]
                    Polyline:
                        name = 'Rapid move'
                        color = 'lime'
                        points = [exit_turn_arc.points[-1], enter_turn_arc.points[0]]

                Arc: enter_turn_arc:
                    # Arc that smoothly re-joins the layer enter arc
                    attr end_point = enter_arc.points[0]
                    attr start_point = end_point + (0, radius, radius)
                    direction = (1, 0, 0)
                    clockwise = not exit_arc.clockwise
                    radius = exit_arc.radius
                    color = 'purple'
                    position = (end_point.x, start_point.y, end_point.z)
                    points = [start_point, end_point]
                Arc: enter_arc:
                    # Arc that enters into the next layer
                    attr end_point = loop.item[0][1]
                    attr start_point = end_point + (connection_line.dx, 0, radius)
                    direction = (0, 1, 0)
                    clockwise = not exit_arc.clockwise
                    radius = exit_arc.radius
                    color = 'purple'
                    position = (end_point.x, end_point.y, start_point.z)
                    points = [start_point, end_point]

            # Zig zag along face
            Looper: point_looper:
                #: Count of arcs up until this layer
                attr arc_count = len(loop.item) * loop.index
                attr layer = loop.item
                attr last_index = len(loop.item) - 1
                iterable = layer
                Polyline:
                    # This is the line going across the surface
                    color = 'blue'
                    name = f'Pass {str(points[0])} to {str(points[1])}'
                    points = loop.item[1:3]
                Conditional:
                    condition << loop.index != point_looper.last_index
                    Arc:
                        # This is the arc that forms a union between two zig-zags
                        # The direction of the arc depends on the count of arcs
                        attr current_arc_count = point_looper.arc_count + loop.index
                        name = f'Union arc {current_arc_count}'
                        color = 'orange'
                        radius = step_over/2
                        clockwise = current_arc_count & 1 == 1
                        attr next_point = point_looper.layer[loop.index + 1][1]
                        attr current_point = loop.item[2]
                        position = current_point.midpoint(next_point)
                        points = [current_point, next_point]

        # Final lead out
        Arc: lead_out_arc:
            name = 'Final out arc'
            attr layer = toolpath[-1]
            attr total_arc_count = len(layer)*len(toolpath)
            attr dstep = 1 if self.clockwise else -1
            attr s = layer[-1][-1]
            attr e = s + (dstep * lead_in_radius, 0, lead_in_radius)
            clockwise = total_arc_count & 1 == 1
            color = 'orange'
            radius = lead_in_radius
            position = (s.x, s.y, e.z)
            points = [s, e]
            direction = (0, 1, 0)
        Polyline: move_out:
            color = 'lime'
            name = 'Rapid move'
            attr p = lead_out_arc.points[-1]
            attr lift_point = p + (0, 0, coerce_point(end_point).z)
            points = [p, lift_point, end_point]
        DisplayArrow: lift_arrow:
            color = 'green'
            cone_size = drop_arrow.cone_size
            tube_size = drop_arrow.tube_size
            description = 'Lift'
            direction = (0, 0, 1)
            position = move_out.lift_point


enamldef Job(Part):
    """ A CNC job. Nest different operations within this and call save
    to write the gcode to a file.

    """
    #: Set to true to disable the whole job
    attr disabled: bool = False

    #: Precision to use when formatting values
    attr precision: int = 6

    #: Output distance values in inches
    attr inches: bool = False

    #: Filename to write to
    attr filename: str = f"{self.name}.nc"

    #: Mapping of tool to tool number
    attr tools: dict = {}

    #: Generate gcode file when all shapes are constructed
    constructed :: self.generate_job()

    activated ::
        if self.disabled:
            # Propagate disabled to all operations
            for c in self.children:
                if isinstance(c, Operation):
                    c.disabled = True

    func format_value(v):
        """ Write formated value """
        if self.inches:
            v = v / 25.4
        return round(v, self.precision)

    func generate_job():
        """ Generate gcode """
        try:
            if self.disabled:
                return
            tools = {}
            with open(self.filename, 'w') as f:
                f.write("(Generated with DeclaraCAD)\n")
                f.write(f"(File: {self.filename})\n")
                f.write(f"(Date: {datetime.now().strftime('%c')})\n")
                # Absolute mode, incremental arc mode, feed per minute, activate xy plane
                f.write("G90 G91.1 G94 G17\n")
                if self.inches:
                    f.write("G20\n")
                else:
                    f.write("G21\n")

                for c in self.children:
                    if isinstance(c, Operation):
                        # Validate tool
                        tool = c.tool
                        num = tool.number

                        if num in tools and tools[num] != tool:
                            raise ValueError(
                                f"Tool number {num} is duplicated! "
                                "Set another number or use a reference if "
                                "multiple operations use the same tool."
                            )
                        tools[num] = tool

                        # Write gcode
                        f.write(c.gcode)

            self.tools = tools
            print(f"Wrote job to {self.filename}")
        except Exception as e:
            print(f"Error generating job: {e}")


enamldef JobSimulation(Part): simulation:
    attr job: Job
    attr rate = 0.2
    attr disabled: bool = False
    attr index: int = 0
    attr frames: list = []
    attr current_tool: Part

    func start():
        if self.disabled:
            return
        frames = []
        for c in self.job.children:
            if isinstance(c, Operation):
                frames.append(c.tool)
                for w in c.topology.wires:
                    path = Topology.discretize(w, rate, method='abscissa')
                    frames.extend(path)
        self.frames = frames
        timer.start()

    func animate():
        try:
            i = self.index
            self.index += 1
            frame = self.frames[i]
            if isinstance(frame, Part):
                self.current_tool = frame
            elif isinstance(frame, Point):
                self.current_tool.position = frame
        except IndexError:
            print("Simulation complete")
            self.index = 0
            timer.stop()
        except Exception as e:
            print(f"Simulation error: {e}")
            timer.stop()

    Include:
        #destroy_old = False
        objects << list(job.tools.values())

    Timer: timer:
        interval = 16
        activated :: simulation.start()
        timeout :: simulation.animate()
