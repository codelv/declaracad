import ast as python_ast
from atom.api import Atom
from enaml.core import enaml_ast
from enaml.core.api import Looper
from enaml.layout.api import RetractItem
from enaml.widgets.api import Container
from enamlx.widgets.api import TreeView, TreeViewItem, TreeViewColumn
from declaracad.core.api import DockItem
from declaracad.core.utils import load_icon
from .plugin import Outline

OUTLINE_ICONS = {
    "function": "tag",
    "class": "brick",
    "enamldef": "bricks",
    "error": "exclamation",
}

def format_node(node: Outline):
    """ Create a node for the outline

    Returns
    -------
    result: Tuple[str, str, str, str]
        A tuple of the format (icon, type string, name, description)

    """
    if isinstance(node, python_ast.FunctionDef):
        return "tag", node.name, "Function"
    elif isinstance(node, python_ast.ClassDef):
        return "brick", node.name, ""
    elif isinstance(node, enaml_ast.EnamlDef):
        return "bricks", node.typename, node.base
    elif isinstance(node, Exception):
        return "exclamation", str(node), str(node.__class__.__name__)
    elif isinstance(node, Atom) and hasattr(node, 'commands'):
        return format_gcode(node)
    return "tag_blue", "", str(node), ""

def format_gcode(cmd):
    return "script", "G-Code", str(len(cmd.commands))


enamldef OutlineDockItem(DockItem): view:
    title = "Outline"
    name = 'code-outline-item'
    icon = load_icon('chart_organisation')

    func goto_item(item: Outline):
        editor = plugin.get_editor()
        editor.goto_position(item.lineno, 0)

        # Retract the item if shown
        dock_area = view.parent
        dock_area.update_layout(RetractItem(item=view.name))

    Container:
        padding = 0
        TreeView: tree:
            minimum_size = (320, 320)
            horizontal_headers = ['Name', 'Type', "Line"]
            horizontal_stretch = True
            resize_mode = 'resize_to_contents'
            items << plugin.active_document.outline
            Looper:
                iterable << tree.items
                TreeViewItem:
                    attr item: Outline << loop.item
                    icon << load_icon(OUTLINE_ICONS.get(item.type, "tag"))
                    text << item.label
                    double_clicked :: goto_item(item)
                    TreeViewColumn:
                        text << item.type
                    TreeViewColumn:
                        text << f"{item.lineno}"
