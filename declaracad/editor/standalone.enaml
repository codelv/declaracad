from enaml.application import Application
from enaml.widgets.api import MainWindow, Container, MenuBar, Menu, Action
from enamlx.widgets.api import KeyEvent

from declaracad.core.utils import load_icon
from .view import EditorFindBar, EditorGotoBar, EditorView
from .plugin import EditorPlugin


enamldef EditorMenuBar(MenuBar):
    Menu:
        title = '&File'
        Action:
            text = 'Quit'
            triggered :: Application.instance().stop()
    Menu:
        title = '&Edit'
        Action:
            text = 'Find'
            triggered :: editor.show_find_bar = True
        Action:
            text = 'Replace'
            triggered :: editor.show_replace_bar = True
        Action:
            text = 'Goto line'
            triggered :: editor.show_replace_bar = True


enamldef StandaloneEditor(MainWindow): view:
    attr plugin: EditorPlugin
    title = "Editor - DeclaraCAD"
    icon = load_icon('logo')
    alias doc: editor_view.editor.doc
    alias editor: editor_view.editor
    EditorMenuBar:
        pass
    EditorView: editor_view:
        pass
