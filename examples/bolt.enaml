# Created in DeclaraCAD
from math import sin, cos, radians, sqrt, pi, tan
from declaracad.occ.api import *

enamldef Hexagon(Polygon):
    count = 6

enamldef HexNut(Transform):
    attr thickness = 2
    attr outer_radius = 3
    attr inner_radius = 1.5
    Chamfer:
        distance = outer_radius/10
        attr top_face = prism.topology.faces[7]
        attr bottom_face = prism.topology.faces[8]
        operations = [top_face, bottom_face]
        Prism: prism:
            vector = (0, 0, thickness)
            Cut:
                Face:
                    Hexagon:
                        radius << outer_radius
                Face:
                    Circle:
                        radius << inner_radius

enamldef HexHead(Common): head:
    """ A chamfered hex head """
    attr height = 2.0
    attr diameter = 6.4
    # Set to 0 to disable
    attr chamfer = diameter/15
    Prism:
        vector = (0, 0, height)
        Face:
            Wire:
                Hexagon: hexagon:
                    radius = diameter/2
    Conditional:
        condition << chamfer > 0
        Cone: top_chamfer:
            position = (0, 0, 0)
            direction = (0, 0, 1)
            radius = (diameter/2) + (head.height-chamfer)
            height = (diameter/2 - chamfer)  + head.height
        Transform:
            operations = [Mirror(y=1), Translate(z=-height)]
            shape = top_chamfer


enamldef HexBolt(Part): bolt:
    """ Hexagonal Head Bolt  """
    #: Height of head
    attr H: float = 2.0

    #: Length of bolt
    attr length: float = 20.0

    # Dimension C / 2
    attr C: float = 6.4
    attr B: float = 5.5
    attr D: float = 5.3

    # Dimension d1 / 2
    attr d1: float = 3.0

    # Size of thread
    attr d: float = 0.5
    attr s: float = 2*D

    # Fillet radius of head and bolt
    attr r: float = 0.2

    attr thread_height: float = d1/4
    attr k: float = 0.6

    func make_cylinder_surface(radius):
        cylinder = Cylinder(radius=radius)
        cylinder.render()
        return cylinder.topology.faces[0]

    Fuse:  fuse:
        color = 'lightblue'
        transparency = 0.8
        HexHead:
            height = H
            diameter = C

        Revol: revol:
            #: Axis of rotation
            direction = (0, 0, 1)
            Face:
                Wire:
                    Polyline:
                        points = [
                            (0, 0, 0),
                            (B/2, 0, 0),
                            (B/2, 0, H),
                            (d1/2+r, 0, H)
                        ]
                    Arc:
                        # Circle center and orientation
                        direction = (0, 1, 0)
                        position = (d1/2+r, 0, H+r)
                        radius = r
                        # start, end
                        points = [(d1/2+r, 0, H), (d1/2, 0, H+r)]
                    Polyline:
                        points = [
                            (d1/2, 0, H+r),
                            (d1/2, 0, H+length-k),
                            (d1/2-k, 0, H+length),
                            (0, 0, H+length),
                            (0, 0, 0)
                        ]
        
        
        #Wire:
                # Note: When a surface is given on a curve  the shape is converted to 2d
                # the wire automatically converts it back to 3d
    
    #Part:
    ThruSections:
    #    color := fuse.color
        #solid = True
        ruled = True
        attr r = d1/2
        
        
        attr d = bolt.length *1/4
        attr dd = bolt.length *3/4 - d
        attr dv = dd * 2 * pi * r 
        attr dr = 0.4
        attr dz = 0.2
        Wire:
            color = 'blue'
            TrimmedCurve: c1:
                surface = make_cylinder_surface(r)
                v = dv
                Line: e3:
                    position = (0, d)
                    direction = (dv, 2*pi)
        Wire:
            color = 'purple'
            TrimmedCurve: c2:
                surface = make_cylinder_surface(r+dr)
                v = dv
                Line: e4:
                    position = e3.position + (0, dz/2)
                    direction = e3.direction
        Wire:
            Transform:
                position = (0, 0, dz)
                shape = c1
        Wire:
            Transform:
                shape = c1
                        #major_radius = bolt.length/10
                    #minor_radius = 0
    #Wire:    
    #        color = 'blue'
    #        TrimmedCurve: c2:
    #            color = 'blue'
    #            surface = make_cylinder_surface(d1/2+0.4)
    #            v = c1.v
    #            Hyperbola: e2:
    #                position = e1.position + (0, 1/4)
    #                rotation = e1.rotation
    #                major_radius = e1.major_radius#-pi/4
    #                minor_radius = 0

enamldef Assembly(Part):
    #HexNut:
    #    pass
    
    HexBolt:  bolt:
        material = 'steel'
        length = 15.0
