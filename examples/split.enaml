# Created in DeclaraCAD
from declaracad.occ.api import *

enamldef Assembly(Part):
    Axis:
        pass
    Split: split:
        # Split the sphere in half along the x axis
        display = False
        Sphere:
            radius = 3
        Plane:
            direction = (1, 0, 0)
    Transform:
        shape = split.topology.solids[0]
        operations = [Translate(x=1)]
    Transform:
        shape = split.topology.solids[1]
        operations = [Translate(x=-1)]
