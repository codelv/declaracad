# Created in DeclaraCAD
import math
from declaracad.occ.api import *
from declaracad.parts.display import Axis
from declaracad.cnc.api import Job, ChamferMill, JobSimulation, ChamferOperation


enamldef SimplePart(Part):
    alias stock
    Chamfer:
        operations = [
            self.children[0].topology.faces[1],
            self.children[0].topology.faces[4]
        ]
        transparency = 0.8
        Fillet:
            radius = 10
            operations = [
                self.children[0].topology.edges[2],
                self.children[0].topology.edges[14],
            ]
            Cut:
                Box: stock:
                    position = (0, 0, -10)
                    dx = 100
                    dy = 70
                    dz = 10
                Cylinder:
                    radius = 12
                    position = (50, 50, -height)
                    height = 10


enamldef TopChamfer(Part):
    alias job
    SimplePart: part:
        pass
    
    Job: job:
        filename = 'cnc_chamfer.nc'
        ChamferOperation: top_chamfer:
            #disabled = True
            surface_speed = 100
            tool = ChamferMill(diameter=8)
            edges = [part.topology.faces[i] for i in (3, 6, 10, 14, 19, 20, 21)]


enamldef BottomChamfer(Part):
    alias job
    SimplePart: part_flipped:
        transform = [Rotate(direction=(1, 0, 0), angle=math.pi)]
        position = (0, stock.dy, -stock.dz)
    Job: job:
        filename = 'cnc_chamfer_bottom.nc'    
        ChamferOperation:
            surface_speed = 100
            tool = ChamferMill(diameter=8, number=2)
            edges = [part_flipped.topology.faces[i] for i in (2, 5, 8, 13, 16, 17, 18)]


enamldef Assembly(Part):
    Axis:
        pass
    
    TopChamfer: top:
        pass
    #BottomChamfer: bottom:
    #    pass
   
    JobSimulation:
        job = top.job
        rate = 0.5
