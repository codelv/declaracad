# Created in DeclaraCAD
from declaracad.parts.display import Axis
from declaracad.occ.api import Part, Cut, Box
from declaracad.cnc.api import Job, EndMill, JobSimulation, SlottingOperation


enamldef SimplePart(Part):
    Cut:
        transparency = 0.8
        Box:
            position = (-dx/2, -dy/2,  -dz)
            dx = 100
            dy = 40
            dz = 10
        Box:
            position = (-dx/2, -dy/2,  -dz)
            dx = 100
            dy = 20
            dz = 5
        
        
enamldef Assembly(Part):
    Axis:
        pass
    SimplePart: part:
        position = (50, 20)
    Job: j:
        filename = 'cnc_trichoid_slot.nc'
        SlottingOperation:
            surface_speed = 100
            slot_width = 20
            tool = EndMill(diameter=6)
            faces = [part.topology.faces[3]]
    JobSimulation:
        job = j
        rate = 0.5
