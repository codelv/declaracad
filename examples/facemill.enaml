# Created in DeclaraCAD
from atom.api import Atom
from declaracad.occ.api import *
from declaracad.cnc.toolpath import Toolpath, ToolpathAnimation
from declaracad.parts.display import BoundingBox
inch = 25.4
    

enamldef FacingOperation(Part):
    """ A zig-zag facing operation. Does not support holes.
    
    """
    attr tool
    attr face
    
    attr clearance_height = 25
    attr feed_height = 5
    attr cut_depth = 10
    attr step_over = tool.radius*0.5
    attr step_down = 1
    attr step_past = tool.radius/2
    attr start_point = Point(-tool.radius-step_over, -tool.radius+step_over, clearance_height)
    attr cut_start = Point(-tool.radius, -tool.radius+step_over, -step_down)
    attr lead_in_radius = step_over
    attr bounding_box = Topology.bbox(face)
    attr toolpath = generate_toolpath(face)
    
    func generate_toolpath(face):
        
        ymin = bounding_box.ymin
        ymax = bounding_box.ymax
        topo = Topology(shape=face)
        
        i = 0
        last = cut_start
        shift = Point(0, -tool.radius)
        #shift = Point(0, 0)
        
        z = bounding_box.zmax
        zmin = z - cut_depth
        layers = []
        while z > zmin:
            points = []
            z = max(z-step_down, zmin)
            y = ymin
            
            start_shift = shift + (step_past, 0)
            end_shift = shift + (-step_past, 0)
            while y <= ymax:
                i += 1
                y += step_over
                space = HalfSpace(position=(0, y, 0), direction=(0,1,0))
                results = topo.intersection(space.render())
                if results:                
                    if len(results) != 1:
                        raise NotImplementedError("TODO: Handle islands")
                    line = Topology.cast_curve(results[0])
                    start_point = Topology.get_value_at(line, line.FirstParameter()) + start_shift
                    end_point = Topology.get_value_at(line, line.LastParameter()) + end_shift
                elif i > 1 and y > ymax:
                    # If it goes past the end there will be no intersection
                    # so add it anyways for the last pass
                    start_point = start_point + (0, step_over, 0)
                    end_point = end_point + (0, step_over, 0)
                
                start_point.z = z
                end_point.z = z
                
                if i & 1 == 0:
                    item = [last, start_point, end_point]
                else:
                    item = [last, end_point, start_point]
                last = item[-1]
                points.append(item)
            layers.append(points)
        return layers
    
    Polyline: move:
        attr e = Point(start_point[0], start_point[1], cut_start.z+lead_in_radius)
        points = [start_point, e]
    
    Arc: lead_in_arc:
        attr s = move.points[-1]
        color = 'yellow'
        radius = lead_in_radius
        clockwise = True
        position = (cut_start.x, s.y, s.z)
        points = [s, cut_start]
        direction = (0, 1, 0)
    Polyline:
        # From lead in to start of cut
        attr layer = toolpath[0]
        
        color = 'blue'
        points = layer[0][0:2]
        
    Looper: layer_looper:
        iterable = toolpath
        Conditional:
            # If not the first layer draw a connection between this layer and the last
            condition = loop.index > 0
            # Section between layers
            
            Arc: exit_arc:
                direction = (0, 1, 0)
                #clockwise = True
                attr start_point = loop.item[0][0]
                radius = step_over/2
                attr end_point = start_point + (-radius, 0, radius)
                position = (start_point.x, start_point.y, end_point.z)
                points = [start_point, end_point]
            Arc: exit_turn_arc:
                direction = (1, 0, 0)
                #clockwise = True
                attr start_point = exit_arc.points[-1]
                radius = step_over/2
                attr end_point = start_point + (0, -radius, radius)
                position = (start_point.x, end_point.y, start_point.z)
                points = [start_point, end_point]
            
            Conditional:
                condition = exit_turn_arc.points[-1] != enter_turn_arc.points[-1]
                Polyline:
                    color = 'lime'
                    points = [exit_turn_arc.points[-1], enter_turn_arc.points[-1]]
            
            Arc: enter_turn_arc:
                direction = (1, 0, 0)
                clockwise = True
                attr start_point = enter_arc.points[-1]
                radius = step_over/2
                attr end_point = start_point + (0, radius, radius)
                position = (start_point.x, end_point.y, start_point.z)
                points = [start_point, end_point]    
            Arc: enter_arc:
                direction = (0, 1, 0)
                #clockwise = True
                attr start_point = loop.item[0][1]
                radius = step_over/2
                attr end_point = start_point + (-radius, 0, radius)
                position = (start_point.x, start_point.y, end_point.z)
                points = [start_point, end_point]
        
        # Zig zag along face
        Looper: point_looper:
            attr layer = loop.item
            iterable = layer
            Polyline:
                color = 'blue'
                points = loop.item[1:3]
            Conditional:
                condition = loop.index > 0            
                Arc:
                    color = 'yellow'
                    radius = step_over/2
                    clockwise = loop.index & 1 == 0
                    position = loop.item[0].midpoint(loop.item[1])
                    points = loop.item[0:2]
        
            
    # Final lead out
    Arc: lead_out_arc:
        attr layer = toolpath[-1]
        clockwise = len(layer) & 1 == 1
        attr dstep = 1 if self.clockwise else -1
        attr s = layer[-1][-1]
        attr e = s + (dstep * lead_in_radius, 0, lead_in_radius)
        color = 'yellow'
        radius = lead_in_radius
        
        position = (s.x, s.y, e.z)
        points = [s, e]
        direction = (0, 1, 0)
    Polyline:
        attr p = lead_out_arc.e
        points = [p, (p.x, p.y, clearance_height)]


enamldef FacingCutter(Part): cutter:
    attr radius = 2*inch/2
    material = 'steel'
    Cylinder:
        material = parent.material
        transparency = parent.transparency
        radius = cutter.radius
        height = 1*inch
    Cylinder:
        material = parent.material
        transparency = parent.transparency
        position = (0, 0, 1*inch)
        radius = 1/2*inch/2
        height = 1*inch
    Vertex:
        color = 'lime'
        position = (0, 0, 0)


enamldef Assembly(Part):
    
    Fuse: part:
        material = 'aluminium'
        transparency = 0.6
        Box: box:
            position = (0, 0, -dz)
            dx = 100
            dy = 100
            dz = 25
        #Cylinder:
        #    position = (box.dx/2, box.dy/2)
        #    radius = 20
        #    height = 2
        
    FacingCutter: cutting_tool:
        transparency = 0.5
        #radius = 2*inch/2
        #height = 3*inch
        position = facing_op.start_point

    
    Wire: facing_operation:
        FacingOperation: facing_op:
            tool = cutting_tool
            face = part.topology.faces[5]
            
    Toolpath: toolpath:
        start_point = facing_op.start_point
        wires = facing_operation.topology.wires
        
    ToolpathAnimation:
        bit = cutting_tool
        toolpath =  toolpath
        speed = 20
        