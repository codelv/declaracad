# Created in DeclaraCAD
from math import pi, radians
from declaracad.occ.api import *


enamldef Assembly(Part):

    # For reference
    Line: xaxis:
        color = 'black'
        direction = (1, 0)
    Line: yaxis:
        color = 'black'
        direction = (0, 1)
    Line: zaxis:
        color = 'black'
        direction = (0, 0, 1)
    Polygon:
        color = 'blue'
        radius = 1
        count = 3
        rotation = radians(5)
        direction = (0, 0, -1)
    Polygon:
        color = 'magenta'
        radius = 1.1
        count = 3
        rotation = radians(5)
        direction = (0, 0, 1)
    Polygon:
       color = 'lime'
       position = (-1, -1, 0)
       rotation = pi
       radius = 1
       count = 3
    Polygon:
       color = 'green'
       position = (-1, -1, 0)
       radius = 1
       count = 3
    Polygon:
       color = 'red'
       direction = (0, 1, 0)
       position = direction
       radius = 1
       count = 3
    Polygon:
        color = 'yellow'
        direction = (1, 0, 0)
        position = direction
        radius = 1
        count = 3
    Polygon:
        color = 'blue'
        direction = (1, 1, 0)
        position = direction
        #rotation = pi
        radius = 1
        count = 3
